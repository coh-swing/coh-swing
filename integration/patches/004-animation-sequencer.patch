+                   newmove->raw.cycleMoveCnt ? newmove->raw.cycleMove[0] : 0,
+                   is_obvious,
+                   isDevelopmentMode(),
+                   isSharedMemory(seq->info));
+    seqWebSwingTransitionLogCount++;
+}
