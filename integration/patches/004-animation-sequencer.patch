+        seq->animation.move == newmove || seqWebSwingTransitionLogCount >= 256)
+        return;
+
+    previousMove = seq->animation.move;
+    current_bits[0] = '\0';
+    for (i = 0; i < STATE_ARRAY_SIZE && used + 1 < sizeof(current_bits); i++)
