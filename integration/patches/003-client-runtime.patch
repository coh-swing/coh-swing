+static void entClientWebSwingResolveMagicVisualAnchor(Entity *e,
+                                                      const Vec3 physics_anchor,
+                                                      const Vec3 tether_start,
+                                                      F32 default_visual_distance,
+                                                      Vec3 visual_anchor)
+{
+    F32 visual_distance = default_visual_distance;
+    Vec3 toward_anchor;
+    Vec3 delta;
+    F32 physics_distance;
+    int needs_refresh;
+
+    if (global_state.webswing_dev &&
+        g_cohsourcedev_webswing_anchor_preview_offset > 0.0f)
+    {
+        visual_distance = g_cohsourcedev_webswing_anchor_preview_offset;
+    }
+
+    needs_refresh = !s_webSwingMagicVisualAnchorValid ||
+                    s_webSwingMagicVisualAnchorPlayer != e ||
+                    s_webSwingMagicVisualAnchorCycle != e->motion->web_swing_assist_cycle_id ||
+                    distance3Squared(s_webSwingMagicVisualAnchorPhysical,
+                                     physics_anchor) > 1.0f;
+
+    if (needs_refresh)
+    {
+        copyVec3(physics_anchor, s_webSwingMagicVisualAnchorPhysical);
+        copyVec3(physics_anchor, s_webSwingMagicVisualAnchor);
+
+        subVec3(physics_anchor, tether_start, toward_anchor);
+        physics_distance = normalVec3(toward_anchor);
+        if (physics_distance > 0.001f)
+        {
+            visual_distance = MIN(visual_distance, physics_distance);
+            scaleVec3(toward_anchor, visual_distance, delta);
+            addVec3(tether_start, delta, s_webSwingMagicVisualAnchor);
+        }
+
+        s_webSwingMagicVisualAnchorPlayer = e;
+        s_webSwingMagicVisualAnchorCycle = e->motion->web_swing_assist_cycle_id;
+        s_webSwingMagicVisualAnchorValid = 1;
+        filelog_printf("webswing.log",
+                       "WEB_SWING CLIENT magic_visual_anchor cycle_id=%u physics=(%.3f,%.3f,%.3f) visual=(%.3f,%.3f,%.3f) visual_distance=%.3f\n",
+                       e->motion->web_swing_assist_cycle_id,
+                       physics_anchor[0], physics_anchor[1], physics_anchor[2],
+                       s_webSwingMagicVisualAnchor[0], s_webSwingMagicVisualAnchor[1],
+                       s_webSwingMagicVisualAnchor[2], visual_distance);
+    }
+
+    copyVec3(s_webSwingMagicVisualAnchor, visual_anchor);
+}
