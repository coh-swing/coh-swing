+                               build, WEBSWING_TRAY_ICON, WEBSWING_TRAY_COMMAND);
+            }
+            checked_player = e;
+            checked_build = build;
+            return;
+        }
+    }
+
+    // Use a normal image macro backed by our namespaced Web Swing texture.
+    // macro_create persists it through the normal tray path.
+    macro_create(WEBSWING_TRAY_NAME, WEBSWING_TRAY_COMMAND, WEBSWING_TRAY_ICON, -1);
+    checked_player = e;
+    checked_build = build;
+    filelog_printf("webswing.log",
