+        Vec3 preview_delta;
+        F32 anchor_distance;
+        F32 preview_distance;
+
+        subVec3(anchor, tether_start, toward_anchor);
+        anchor_distance = normalVec3(toward_anchor);
+        if (anchor_distance > 0.001f)
+        {
+            preview_distance = MIN(g_cohsourcedev_webswing_anchor_preview_offset,
+                                   anchor_distance);
+            scaleVec3(toward_anchor, preview_distance, preview_delta);
+            addVec3(tether_start, preview_delta, visual_anchor);
+        }
+    }
+}
