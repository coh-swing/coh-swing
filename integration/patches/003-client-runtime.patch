+                stricmp(obj->shortName, WEBSWING_TRAY_NAME) ||
+                stricmp(obj->iconName, WEBSWING_TRAY_ICON))
+            {
+                TrayObj upgraded = {0};
+                buildMacroTrayObj(&upgraded,
+                                  WEBSWING_TRAY_COMMAND,
+                                  WEBSWING_TRAY_NAME,
+                                  WEBSWING_TRAY_ICON,
