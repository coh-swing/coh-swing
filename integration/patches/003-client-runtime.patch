+static const char *game_webSwingAutoplayStateName(WebSwingAutoplayState state)
+{
+    switch (state)
+    {
+        case WEBSWING_AUTOPLAY_WAIT_READY:       return "WAIT_READY";
+        case WEBSWING_AUTOPLAY_WAIT_ARMED:       return "WAIT_ARMED";
+        case WEBSWING_AUTOPLAY_PREROLL:          return "PREROLL";
+        case WEBSWING_AUTOPLAY_FIRST_PRESS_DOWN: return "FIRST_PRESS_DOWN";
+        case WEBSWING_AUTOPLAY_WAIT_SECOND_PRESS:return "WAIT_SECOND_PRESS";
+        case WEBSWING_AUTOPLAY_HIGH_DROP_FALL:   return "HIGH_DROP_FALL";
+        case WEBSWING_AUTOPLAY_RUNNING:          return "RUNNING";
+        default:                                 return "UNKNOWN";
+    }
+}
+
+static void game_transitionWebSwingAutoplay(WebSwingAutoplayState next,
+                                             const char *reason)
+{
+    filelog_printf("webswing.log",
+                   "WEB_SWING CLIENT autoplay previous=%s state=%s reason=%s preroll_frames=%d\n",
+                   game_webSwingAutoplayStateName(s_webSwingAutoplayState),
+                   game_webSwingAutoplayStateName(next),
+                   reason ? reason : "unspecified",
+                   s_webSwingAutoplayPrerollFrames);
+    s_webSwingAutoplayState = next;
+}
+
+static void game_resetWebSwingAutoplay(int restore_controls, const char *reason)
+{
+    if (restore_controls && s_webSwingAutoplayOwnsUp)
+    {
+        updateControlState(CONTROLID_UP, MOVE_INPUT_OTHER, 0,
+                           control_state.time.last_send_ms);
+    }
+    if (restore_controls && s_webSwingAutoplayOwnsAutorun)
+    {
+        control_state.autorun = s_webSwingAutoplayPreviousAutorun;
+        updateControlState(CONTROLID_FORWARD, MOVE_INPUT_OTHER,
+                           control_state.autorun ? 1 : 0,
+                           control_state.time.last_send_ms);
+    }
+    if (s_webSwingAutoplayOwnsCapture)
+        g_cohsourcedev_webswing_capture = s_webSwingAutoplayPreviousCapture;
+
+    if (s_webSwingAutoplayState != WEBSWING_AUTOPLAY_WAIT_READY)
+        game_transitionWebSwingAutoplay(WEBSWING_AUTOPLAY_WAIT_READY, reason);
+    s_webSwingAutoplayPrerollFrames = 0;
+    s_webSwingAutoplayOwnsUp = 0;
+    s_webSwingAutoplayOwnsAutorun = 0;
+    s_webSwingAutoplayOwnsCapture = 0;
+    s_webSwingAutoplayPlayer = NULL;
+    s_webSwingAutoplayFrameCadence = 0;
+    s_webSwingAutoplayFrameDumpCount = 0;
+    s_webSwingAutoplayFrameLimitLogged = 0;
+    s_webSwingAutoplayHighDropFrames = 0;
+    if (s_webSwingAutoplayOwnsCameraYaw)
+    {
+        control_state.cam_pyr_offset[1] = s_webSwingAutoplayPreviousCameraYaw;
+        cam_info.rotate_scale = 1;
+        s_webSwingAutoplayOwnsCameraYaw = 0;
+    }
+}
+
+static void game_applyWebSwingAutoplayCamera(void)
+{
+    if (!s_webSwingAutoplayRequested || !global_state.webswing_dev ||
+        !s_webSwingAutoplayCameraYawRequested)
+        return;
+
+    // engine_update() consumes this value when it builds the third-person
+    // camera. Reapply it every frame because normal follow-camera logic may
+    // otherwise recenter the offset as the autoplay route changes heading.
+    control_state.cam_pyr_offset[1] = RAD(s_webSwingAutoplayCameraYawDegrees);
+    cam_info.rotate_scale = 1;
+}
+
+static void game_enableWebSwingAutoplayAutorun(void)
+{
+    control_state.autorun = 1;
+    updateControlState(CONTROLID_FORWARD, MOVE_INPUT_OTHER, 1,
+                       control_state.time.last_send_ms);
+}
+
+static void game_processWebSwingAutoplay(void)
+{
+    extern int glob_have_camera_pos;
+    Entity *player = controlledPlayerPtr();
+    int ready;
+
+    if (!s_webSwingAutoplayRequested || !global_state.webswing_dev)
+    {
+        if (s_webSwingAutoplayState != WEBSWING_AUTOPLAY_WAIT_READY)
+            game_resetWebSwingAutoplay(1, "development_gate_lost");
+        return;
+    }
+
+    ready = commConnected() && player && player->motion &&
+            glob_have_camera_pos == PLAYING_GAME &&
+            game_state.game_mode == SHOW_GAME && isMenu(MENU_GAME) &&
+            control_state.first_packet_sent &&
+            control_state.mapserver_responding;
+    if (!ready)
+    {
+        if (s_webSwingAutoplayPlayer ||
+            s_webSwingAutoplayState != WEBSWING_AUTOPLAY_WAIT_READY)
+            game_resetWebSwingAutoplay(1, "world_readiness_lost");
+        return;
+    }
+
+    if (s_webSwingAutoplayPlayer && s_webSwingAutoplayPlayer != player)
+        game_resetWebSwingAutoplay(1, "controlled_player_changed");
+
+    switch (s_webSwingAutoplayState)
+    {
+        case WEBSWING_AUTOPLAY_WAIT_READY:
+            s_webSwingAutoplayPlayer = player;
+            s_webSwingAutoplayPreviousAutorun = control_state.autorun;
+            s_webSwingAutoplayOwnsAutorun = 1;
+            if (s_webSwingAutoplayCameraYawRequested && !s_webSwingAutoplayOwnsCameraYaw)
+            {
+                s_webSwingAutoplayPreviousCameraYaw = control_state.cam_pyr_offset[1];
+                s_webSwingAutoplayOwnsCameraYaw = 1;
+            }
+            if (s_webSwingAutoplayFramesRequested)
+            {
+                control_state.autorun = 0;
+                updateControlState(CONTROLID_FORWARD, MOVE_INPUT_OTHER, 0,
+                                   control_state.time.last_send_ms);
+                // Face south from farther upstream on the same verified Steel
+                // Canyon road. Starting at z=900 reached the Silver Lake
+                // waterfront late in the bounded run; this preserves the route
+                // and provides the full evidence window before that boundary.
+                cmdParse("setpospyr -2369.407 -84.500 1800.000 0 3.141593 0");
+                // Keep hands and feet in frame throughout the larger release
+                // arc. This is scoped to the explicit bounded dev harness.
+                cmdParse("camdist 24");
+                filelog_printf("webswing.log",
+                                "WEB_SWING CLIENT autoplay_frames reset_position=1 "
+                                "position=-2369.407,-84.500,1800.000 "
+                                "yaw=3.141593 camera_distance=24 route=southbound_open_road\n");
+            }
+            else
+            {
+                game_enableWebSwingAutoplayAutorun();
+            }
+            s_webSwingAutoplayPreviousCapture = g_cohsourcedev_webswing_capture;
+            s_webSwingAutoplayOwnsCapture = 1;
+            g_cohsourcedev_webswing_capture = 1;
+            commAddInput("webswingbackend 1");
+            commAddInput("webswing 1");
+            game_transitionWebSwingAutoplay(WEBSWING_AUTOPLAY_WAIT_ARMED,
+                                            "ready_arm_requested");
+            break;
+
+        case WEBSWING_AUTOPLAY_WAIT_ARMED:
+            if (control_state.server_state &&
+                control_state.server_state->web_swing &&
+                control_state.server_state->web_swing_backend &&
+                !player->motion->falling && !player->motion->jumping &&
+                !player->motion->web_swing_attached)
+            {
+                s_webSwingAutoplayPrerollFrames = 0;
+                game_transitionWebSwingAutoplay(WEBSWING_AUTOPLAY_PREROLL,
+                                                "server_confirmed_grounded");
+            }
+            break;
+
+        case WEBSWING_AUTOPLAY_PREROLL:
+            if (!control_state.server_state ||
+                !control_state.server_state->web_swing ||
+                !control_state.server_state->web_swing_backend)
+            {
+                s_webSwingAutoplayPrerollFrames = 0;
+                commAddInput("webswingbackend 1");
+                commAddInput("webswing 1");
+                game_transitionWebSwingAutoplay(WEBSWING_AUTOPLAY_WAIT_ARMED,
+                                                "server_confirmation_lost");
+            }
+            else if (player->motion->falling || player->motion->jumping ||
+                     player->motion->web_swing_attached)
+            {
+                s_webSwingAutoplayPrerollFrames = 0;
+            }
+            else if (++s_webSwingAutoplayPrerollFrames >= WEBSWING_AUTOPLAY_PREROLL_FRAMES)
+            {
+                if (s_webSwingAutoplayFramesRequested)
+                    game_enableWebSwingAutoplayAutorun();
+                updateControlState(CONTROLID_UP, MOVE_INPUT_OTHER, 1,
+                                   control_state.time.last_send_ms);
+                s_webSwingAutoplayOwnsUp = 1;
+                game_transitionWebSwingAutoplay(WEBSWING_AUTOPLAY_FIRST_PRESS_DOWN,
+                                                "preroll_complete_90_frames");
+            }
+            break;
+
+        case WEBSWING_AUTOPLAY_FIRST_PRESS_DOWN:
+            if (player->motion->falling || player->motion->jumping)
+            {
+                updateControlState(CONTROLID_UP, MOVE_INPUT_OTHER, 0,
+                                   control_state.time.last_send_ms);
+                s_webSwingAutoplayOwnsUp = 0;
+                if (s_webSwingAutoplayHighDropRequested)
+                {
+                    cmdParse("setpospyr -2369.407 100.000 1800.000 0 3.141593 0");
+                    s_webSwingAutoplayHighDropFrames = 0;
+                    filelog_printf("webswing.log",
+                                   "WEB_SWING CLIENT autoplay_high_drop teleported=1 position=-2369.407,100.000,1800.000 target_min_fall_frames=%d\n",
+                                   WEBSWING_AUTOPLAY_HIGH_DROP_MIN_FRAMES);
+                    game_transitionWebSwingAutoplay(WEBSWING_AUTOPLAY_HIGH_DROP_FALL,
+                                                    "first_jump_airborne_high_drop");
+                }
+                else
+                {
+                    game_transitionWebSwingAutoplay(WEBSWING_AUTOPLAY_WAIT_SECOND_PRESS,
+                                                    "first_jump_airborne_release");
+                }
+            }
+            break;
+
+        case WEBSWING_AUTOPLAY_WAIT_SECOND_PRESS:
+            if (player->motion->web_swing_second_press_armed &&
+                (player->motion->falling || player->motion->jumping))
+            {
+                updateControlState(CONTROLID_UP, MOVE_INPUT_OTHER, 1,
+                                   control_state.time.last_send_ms);
+                s_webSwingAutoplayOwnsUp = 1;
+                game_transitionWebSwingAutoplay(WEBSWING_AUTOPLAY_RUNNING,
+                                                "second_press_armed_airborne");
+            }
+            else if (!player->motion->falling && !player->motion->jumping)
+            {
+                game_transitionWebSwingAutoplay(WEBSWING_AUTOPLAY_WAIT_ARMED,
+                                                "landed_before_second_press");
+            }
+            break;
+
+        case WEBSWING_AUTOPLAY_HIGH_DROP_FALL:
+            ++s_webSwingAutoplayHighDropFrames;
+            if (player->motion->web_swing_second_press_armed &&
+                player->motion->falling &&
+                s_webSwingAutoplayHighDropFrames >= WEBSWING_AUTOPLAY_HIGH_DROP_MIN_FRAMES &&
+                player->motion->vel[1] <= -1.50f)
+            {
+                filelog_printf("webswing.log",
+                               "WEB_SWING CLIENT autoplay_high_drop cast frames=%d player_y=%.3f vertical_speed=%.3f highest_y=%.3f measured_fall=%.3f\n",
+                               s_webSwingAutoplayHighDropFrames,
+                               ENTPOSY(player),
+                               player->motion->vel[1],
+                               player->motion->highest_height,
+                               MAX(0.0f, player->motion->highest_height - ENTPOSY(player)));
+                updateControlState(CONTROLID_UP, MOVE_INPUT_OTHER, 1,
+                                   control_state.time.last_send_ms);
+                s_webSwingAutoplayOwnsUp = 1;
+                game_transitionWebSwingAutoplay(WEBSWING_AUTOPLAY_RUNNING,
+                                                "high_drop_second_press");
+            }
+            break;
+
+        case WEBSWING_AUTOPLAY_RUNNING:
+            // Keep the second Space press held. Releasing it is the real Web
+            // Swing detach command; automatic assisted cycles need it on.
+            break;
+    }
+}
+
+static void game_processWebSwingAutoplayFrames(void)
+{
+    int capture_active;
+
+    if (!s_webSwingAutoplayFramesRequested ||
+        !s_webSwingAutoplayRequested ||
+        !global_state.webswing_dev)
+        return;
+
+    capture_active =
+        (s_webSwingAutoplayState == WEBSWING_AUTOPLAY_PREROLL &&
+         s_webSwingAutoplayPrerollFrames >= WEBSWING_AUTOPLAY_CAPTURE_PREROLL_START) ||
+        s_webSwingAutoplayState == WEBSWING_AUTOPLAY_FIRST_PRESS_DOWN ||
+        s_webSwingAutoplayState == WEBSWING_AUTOPLAY_WAIT_SECOND_PRESS ||
+        s_webSwingAutoplayState == WEBSWING_AUTOPLAY_HIGH_DROP_FALL ||
+        s_webSwingAutoplayState == WEBSWING_AUTOPLAY_RUNNING;
+    if (!capture_active)
+        return;
+
+    if (s_webSwingAutoplayFrameDumpCount >= s_webSwingAutoplayFrameLimit)
+    {
+        if (!s_webSwingAutoplayFrameLimitLogged)
+        {
+            filelog_printf("webswing.log",
+                           "WEB_SWING CLIENT autoplay_frames state=CAPTURE_LIMIT "
+                           "reason=bounded_capture_complete frames=%d cadence=%d stopping_autoplay=1\n",
+                           s_webSwingAutoplayFrameDumpCount,
+                           WEBSWING_AUTOPLAY_CAPTURE_CADENCE);
+            s_webSwingAutoplayFrameLimitLogged = 1;
+        }
+
+        // A bounded visual audit is one transaction: once the final requested
+        // screenshot exists, release the synthetic Space/autorun inputs and
+        // restore the previous capture flag as well.  Leaving autoplay running
+        // after the image evidence stopped used to create minutes of unrelated
+        // telemetry (and even terrain collisions) that looked like late-cycle
+        // Web Swing failures despite occurring outside the bounded review.
+        s_webSwingAutoplayRequested = 0;
+        s_webSwingAutoplayFramesRequested = 0;
+        game_resetWebSwingAutoplay(1, "bounded_capture_complete");
+        return;
+    }
+
+    if (s_webSwingAutoplayFrameCadence++ % WEBSWING_AUTOPLAY_CAPTURE_CADENCE)
+        return;
+
+    if (s_webSwingAutoplayFrameDumpCount == 0)
+    {
+        filelog_printf("webswing.log",
+                       "WEB_SWING CLIENT autoplay_frames state=CAPTURE_STARTED "
+                       "reason=late_preroll output=webswing-autoplay-capture "
+                       "limit=%d cadence=%d\n",
+                       s_webSwingAutoplayFrameLimit,
+                       WEBSWING_AUTOPLAY_CAPTURE_CADENCE);
+    }
+    gfxScreenDump("webswing-autoplay-capture", 1, "jpg");
+    s_webSwingAutoplayFrameDumpCount++;
+}
