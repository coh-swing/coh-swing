+    // install. Only surface the player-facing button when the packaged Web
+    // Swing state namespace is actually present.
+    if (seqGetStateNumberFromName("WEBSWING_AIRBORNE") < 0)
+        return;
+
+    build = e->pchar->iCurBuild;
+    if (checked_player == e && checked_build == build)
+        return;
