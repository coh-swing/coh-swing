+static void entClientWebSwingStopMagicNativeParts(void)
+{
+    int i;
+    for (i = 0; i < WEBSWING_MAGIC_NATIVE_PART_COUNT; ++i)
+    {
+        if (partConfirmValid(s_webSwingMagicNativeParts[i],
+                             s_webSwingMagicNativePartIds[i]))
+        {
+            partSoftKillSystem(s_webSwingMagicNativeParts[i],
+                               s_webSwingMagicNativePartIds[i]);
+        }
+        s_webSwingMagicNativeParts[i] = NULL;
+        s_webSwingMagicNativePartIds[i] = 0;
+    }
+    s_webSwingMagicNativePartsLogged = 0;
+}
+
+static int entClientWebSwingManageMagicNativeParts(const Vec3 anchor,
+                                                   const Vec3 tether_start,
+                                                   F32 anchor_fraction)
+{
+    F32 rune_layout_scale = 1.0f;
+    F32 rune_particle_scale = 0.50f;
+    Mat4 mat;
+    Vec3 visual_anchor;
+    Vec3 rune_normal;
+    Vec3 camera_delta;
+    F32 camera_distance;
+    F32 camera_visibility;
+    U8 inherited_alpha;
+    int i;
+    int alive = 0;
+
+    if (anchor_fraction < 0.35f || !validateVec3(anchor))
+        return 0;
+
+    copyVec3(anchor, visual_anchor);
+
+    // Lore anchors live at the *real* pendulum endpoint.  Never drag them down
+    // the rope toward the player just to keep them on camera: that caused both
+    // rune and drone to sweep through the foreground as the camera/player moved
+    // around the fixed near-field object.  Instead, scale modestly with viewing
+    // distance and fade away if the camera ever gets unusually close.
+    subVec3(visual_anchor, cam_info.cammat[3], camera_delta);
+    camera_distance = lengthVec3(camera_delta);
+    if (camera_distance < 18.0f)
+    {
+        entClientWebSwingStopMagicNativeParts();
+        return 0;
+    }
+    camera_visibility = MINMAX((camera_distance - 18.0f) / 18.0f, 0.0f, 1.0f);
+    rune_particle_scale = MINMAX(0.50f + camera_distance * 0.0045f, 0.50f, 1.20f);
+
+    // Treat the magical anchor as a summoned ceiling plate, not a billboard
+    // attached to the rope.  Tether-facing orientation made the rune rotate
+    // into the camera whenever the web direction approached the view axis,
+    // producing a giant full-screen flash.  Keep the rune horizontal in world
+    // space for the entire swing; the tether may move around it, but the plate
+    // itself remains stable.
+    copyMat4(unitmat, mat);
+    pitchMat3(RAD(180.0f), mat);
+    scaleMat3(mat, mat, rune_layout_scale);
+    copyVec3(visual_anchor, mat[3]);
+    copyVec3(mat[1], rune_normal);
+    normalVec3(rune_normal);
+    inherited_alpha = (U8)MINMAX(anchor_fraction * camera_visibility * 255.0f,
+                                 0.0f, 255.0f);
+
+    for (i = 0; i < WEBSWING_MAGIC_NATIVE_PART_COUNT; ++i)
+    {
+        ParticleSystem *system = partConfirmValid(s_webSwingMagicNativeParts[i],
+                                                  s_webSwingMagicNativePartIds[i]);
+        if (!system)
+        {
+            int id = 0;
+            system = partCreateSystem((char *)s_webSwingMagicNativePartNames[i],
+                                      &id, PARTICLE_KICKSTART, 10,
+                                      FX_WORLDFX, 1.0f);
+            s_webSwingMagicNativeParts[i] = system;
+            s_webSwingMagicNativePartIds[i] = id;
+            if (system)
+            {
+                // Particle quads are sized independently from the parent
+                // transform.  A mild size bump keeps the glyphs readable at
+                // gameplay distance without recreating the giant proof pass.
+                system->startsize *= rune_particle_scale;
+                system->endsize *= rune_particle_scale;
+
+                // The stock Rune of Protection is staged as a power effect and
+                // therefore lets these layers populate gradually.  A traversal
+                // anchor needs to be readable the instant the tether connects,
+                // so guarantee one initial glyph/plate particle and modestly
+                // raise the sustain rate without changing the shipped textures.
+                system->burst = MAX(system->burst, 1);
+                system->new_per_frame = MAX(system->new_per_frame, 0.14f);
+            }
+        }
+        if (system && partConfirmValid(system, s_webSwingMagicNativePartIds[i]))
+        {
+            partSetOriginMat(system, s_webSwingMagicNativePartIds[i], mat);
+            partSetInheritedAlpha(system, s_webSwingMagicNativePartIds[i],
+                                  inherited_alpha);
+            ++alive;
+        }
+    }
+
+    if (!s_webSwingMagicNativePartsLogged)
+    {
+        filelog_printf("webswing.log",
+                       "WEB_SWING CLIENT magic_native_parts alive=%d visual_anchor=(%.3f,%.3f,%.3f) preview_from_player=%.3f fraction=%.3f layout_scale=%.2f particle_scale=%.2f rune_normal=(%.3f,%.3f,%.3f)\n",
+                       alive, visual_anchor[0], visual_anchor[1], visual_anchor[2],
+                       g_cohsourcedev_webswing_anchor_preview_offset,
+                       anchor_fraction, rune_layout_scale, rune_particle_scale,
+                       rune_normal[0], rune_normal[1], rune_normal[2]);
+        for (i = 0; i < WEBSWING_MAGIC_NATIVE_PART_COUNT; ++i)
+        {
+            ParticleSystem *system = partConfirmValid(s_webSwingMagicNativeParts[i],
+                                                      s_webSwingMagicNativePartIds[i]);
+            if (system && system->sysInfo)
+            {
+                filelog_printf("webswing.log",
+                               "WEB_SWING CLIENT magic_native_part i=%d name=%s id=%d start=%.3f end=%.3f burst=%d new_per_frame=%.3f emission_life=%.3f fade_out_by=%.3f facing=%d posmode=%d tex0=%s tex1=%s\n",
+                               i, s_webSwingMagicNativePartNames[i],
+                               s_webSwingMagicNativePartIds[i],
+                               system->startsize, system->endsize, system->burst,
+                               system->new_per_frame, system->emission_life_span,
+                               system->sysInfo->fade_out_by,
+                               system->sysInfo->frontorlocalfacing,
+                               system->sysInfo->worldorlocalposition,
+                               system->sysInfo->parttex[0].texturename,
+                               system->sysInfo->parttex[1].texturename);
+            }
+        }
+        s_webSwingMagicNativePartsLogged = 1;
+    }
+
+    return alive > 0;
+}
+
+static int entClientWebSwingManageTechAnchorModel(const Vec3 anchor,
+                                                  F32 anchor_fraction)
+{
+    F32 drone_scale;
+    Vec3 camera_delta;
+    F32 camera_distance;
+    F32 camera_visibility;
+    char *model_path = NULL;
+
+    if (anchor_fraction < 0.35f || !validateVec3(anchor))
+        return 0;
+
+    subVec3(anchor, cam_info.cammat[3], camera_delta);
+    camera_distance = lengthVec3(camera_delta);
+    if (camera_distance < 18.0f)
+    {
+        if (s_webSwingTechAnchorNode)
+            gfxNodeSetAlpha(s_webSwingTechAnchorNode, 0, 1);
+        return 0;
+    }
+    camera_visibility = MINMAX((camera_distance - 18.0f) / 18.0f, 0.0f, 1.0f);
+    drone_scale = MINMAX(3.5f + camera_distance * 0.025f, 3.5f, 8.0f);
+
+    if (!s_webSwingTechAnchorModel)
+    {
+        model_path = objectLibraryPathFromObj("FX_Drone");
+        if (model_path)
+        {
+            s_webSwingTechAnchorModel = modelFind(
+                "FX_Drone", model_path, LOAD_NOW,
+                GEO_INIT_FOR_DRAWING | GEO_USED_BY_GFXTREE);
+        }
+        filelog_printf("webswing.log",
+                       "WEB_SWING CLIENT tech_anchor_model_load path=%s model=%p\n",
+                       model_path ? model_path : "<null>",
+                       s_webSwingTechAnchorModel);
+    }
+
+    if (!s_webSwingTechAnchorModel)
+        return 0;
+
+    if (!s_webSwingTechAnchorNode)
+    {
+        s_webSwingTechAnchorNode = gfxTreeInsert(NULL);
+        if (!s_webSwingTechAnchorNode)
+            return 0;
+        s_webSwingTechAnchorNode->model = s_webSwingTechAnchorModel;
+        if (s_webSwingTechAnchorModel->trick)
+        {
+            gfxTreeInitGfxNodeWithObjectsTricks(
+                s_webSwingTechAnchorNode, s_webSwingTechAnchorModel->trick);
+            s_webSwingTechAnchorNode->trick_from_where = TRICKFROM_MODEL;
+        }
+        filelog_printf("webswing.log",
+                       "WEB_SWING CLIENT tech_anchor_node_create node=%p model=%s radius=%.3f scale=%.2f\n",
+                       s_webSwingTechAnchorNode,
+                       s_webSwingTechAnchorModel->name ? s_webSwingTechAnchorModel->name : "<null>",
+                       s_webSwingTechAnchorModel->radius, drone_scale);
+    }
+
+    copyMat4(unitmat, s_webSwingTechAnchorNode->mat);
+    // Give the deployed anchor a restrained hover-device motion without ever
+    // steering it toward the camera or tether.  A fixed world-space yaw keeps
+    // it readable and avoids the same view-axis flashing failure the rune had.
+    yawMat3((F32)global_state.global_frame_count * 0.012f,
+            s_webSwingTechAnchorNode->mat);
+    scaleMat3(s_webSwingTechAnchorNode->mat, s_webSwingTechAnchorNode->mat,
+              drone_scale);
+    copyVec3(anchor, s_webSwingTechAnchorNode->mat[3]);
+    gfxNodeSetAlpha(s_webSwingTechAnchorNode,
+                    (U8)MINMAX(anchor_fraction * camera_visibility * 255.0f,
+                               0.0f, 255.0f), 1);
+    return 1;
+}
