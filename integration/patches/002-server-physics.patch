+            motion->web_swing_attach_grounded = !motion->falling && !motion->jumping;
+            motion->web_swing_attach_falling = motion->falling;
+            motion->web_swing_attach_jumping = motion->jumping;
+            motion->web_swing_attach_catch_pending =
