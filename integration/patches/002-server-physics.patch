+static const char *pmotionWebSwingCaptureHudFloat(F32 value, char *buffer, size_t buffer_size)
+{
+    if (value < -0.5f)
+        strcpy_s(buffer, buffer_size, "n/a");
+    else
+        sprintf_s(buffer, buffer_size, "%0.2f", value);
+    return buffer;
+}
