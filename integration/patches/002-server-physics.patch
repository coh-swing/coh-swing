+static void webSwingAssistedSetPhase(Entity *e, WebSwingAssistPhase phase, const char *reason)
+{
+    MotionState *motion = e->motion;
+    WebSwingAssistPhase previous = (WebSwingAssistPhase)motion->web_swing_assist_phase;
+
+    if(previous == phase)
+        return;
+
+    motion->web_swing_assist_phase = phase;
+    motion->web_swing_assist_phase_ticks = 0;
+    motion->web_swing_ground_launch_active = phase == WEB_SWING_ASSIST_LAUNCH;
+    filelog_printf("webswing.log",
+                   "WEB_SWING %s assisted_phase previous=%s phase=%s reason=%s cycle_id=%u segment_id=%u pos=(%.2f %.2f %.2f) velocity=(%.3f %.3f %.3f) preserve_velocity=1\n",
+                   WEB_SWING_LOG_SIDE,
+                   webSwingAssistPhaseName(previous),
+                   webSwingAssistPhaseName(phase),
+                   reason,
+                   motion->web_swing_assist_cycle_id,
+                   motion->web_swing_anim_segment_id,
+                   vecParamsXYZ(ENTPOS(e)),
+                   vecParamsXYZ(motion->vel));
+}
+
+static void webSwingAssistedBegin(Entity *e, int grounded)
+{
+    MotionState *motion = e->motion;
+    WebSwingAssistPhase initial_phase;
+    F32 horizontal_speed = sqrt(SQR(motion->vel[0]) + SQR(motion->vel[2]));
+    F32 downward_speed = grounded ? 0.0f : MAX(0.0f, -motion->vel[1]);
+    F32 fall_distance = grounded ? 0.0f : MAX(0.0f,
+        motion->highest_height - ENTPOSY(e));
+    F32 air_entry_extra_depth = grounded ? 0.0f : MIN(
+        WEB_ASSIST_AIR_ENTRY_EXTRA_DEPTH_MAX,
+        MAX(fall_distance * WEB_ASSIST_AIR_ENTRY_FALL_DEPTH_RATIO,
+            downward_speed * WEB_ASSIST_AIR_ENTRY_SPEED_DEPTH));
+    F32 entry_plane_speed = sqrt(SQR(horizontal_speed) + SQR(downward_speed));
+
+    if(grounded)
+        initial_phase = WEB_SWING_ASSIST_LAUNCH;
+    else if(motion->vel[1] > 0.20f)
+        initial_phase = WEB_SWING_ASSIST_ASCEND;
+    else if(motion->vel[1] < -0.20f)
+        initial_phase = WEB_SWING_ASSIST_DESCEND;
+    else
+        initial_phase = WEB_SWING_ASSIST_APEX;
+
+    motion->web_swing_assist_cycle_id = 1;
+    motion->web_swing_assist_energy = grounded ? 0.0f :
+        MINMAX((entry_plane_speed - WEB_ASSIST_HORIZONTAL_MIN_SPEED) *
+               WEB_ASSIST_REATTACH_ENERGY_PER_SPEED,
+               0.0f, WEB_ASSIST_MAX_ENERGY);
+    // SKY_ASSISTED does not use the visible endpoint as a rigid pivot, but
+    // the attachment still authors the altitude band for this run.  The
+    // fictional pivot and line length define a low point in world space so
+    // a rooftop/high-air attachment does not normalize back to street level.
+    motion->web_swing_assist_initial_low_point_y =
+        motion->web_swing_anchor[1] - motion->web_swing_rope_length -
+        WEB_ASSIST_ALTITUDE_ARC_DEPTH - air_entry_extra_depth;
+    motion->web_swing_assist_low_point_y = motion->web_swing_assist_initial_low_point_y;
+    motion->web_swing_handoff_release_y = ENTPOSY(e);
+    motion->web_swing_handoff_launch_segment_id = 0;
+    motion->web_swing_assist_current_clearance = -1.0f;
+    motion->web_swing_assist_ahead_clearance = -1.0f;
+    motion->web_swing_assist_lookahead_distance = -1.0f;
+    motion->web_swing_assist_altitude_margin = 0.0f;
+    motion->web_swing_assist_swoop_active = 0;
+    motion->web_swing_assist_swoop_entry_plane_speed = 0.0f;
+    motion->web_swing_assist_swoop_entry_angle = 0.0f;
+    motion->web_swing_assist_swoop_radius = 0.0f;
+    motion->web_swing_assist_swoop_emergency_count = 0;
+    motion->web_swing_assist_phase = WEB_SWING_ASSIST_NONE;
+    motion->web_swing_visual_tether_visible = 1;
+    motion->web_swing_visual_tether_gap_ticks = 0;
+    motion->web_swing_visual_tether_shoot_ticks = 0;
+    motion->web_swing_visual_tether_shoot_time = 0.0f;
+    motion->web_swing_anim_catch_ticks = 0;
+    motion->web_swing_handoff_release_y = ENTPOSY(e);
+    motion->web_swing_anim_release_ticks = 0;
+    motion->web_swing_anim_shoot_active = 0;
+    motion->web_swing_visual_tether_state = WEB_SWING_VISUAL_TETHER_EXTENDING;
+    motion->web_swing_visual_tether_progress = 0.0f;
+    filelog_printf("webswing.log",
+                   "WEB_SWING %s assisted_altitude_band event=BEGIN attach_y=%.3f anchor_y=%.3f rope=%.3f low_point_y=%.3f grounded=%d fall_distance=%.3f downward_speed=%.3f entry_plane_speed=%.3f air_entry_extra_depth=%.3f initial_energy=%.3f preserve_elevation=1\n",
+                   WEB_SWING_LOG_SIDE,
+                   ENTPOSY(e),
+                   motion->web_swing_anchor[1],
+                   motion->web_swing_rope_length,
+                   motion->web_swing_assist_low_point_y,
+                   grounded,
+                   fall_distance,
+                   downward_speed,
+                   entry_plane_speed,
+                   air_entry_extra_depth,
+                   motion->web_swing_assist_energy);
+    webSwingAssistedSetPhase(e, initial_phase, grounded ? "GROUND_ACTIVATION" : "AIRBORNE_REATTACH");
+}
+
+static void webSwingSetAssistedVisualAnchor(Entity *e, const Vec3 travel_intent)
+{
+    MotionState *motion = e->motion;
+    Vec3 lead;
+    F32 previous_low_point = motion->web_swing_assist_low_point_y;
+    F32 candidate_low_point;
+    F32 minimum_low_point;
+    F32 horizontal_speed = sqrt(SQR(motion->vel[0]) + SQR(motion->vel[2]));
+    F32 altitude_to_low_point = MAX(0.0f,
+        ENTPOSY(e) - motion->web_swing_assist_low_point_y);
+    F32 bottom_lead = MINMAX(
+        altitude_to_low_point * WEB_ASSIST_ANCHOR_BOTTOM_LEAD_ALTITUDE,
+        WEB_ASSIST_ANCHOR_BOTTOM_LEAD_MIN,
+        WEB_ASSIST_ANCHOR_BOTTOM_LEAD_MAX);
+    F32 predicted_cast_time = WEB_ASSIST_VISUAL_TETHER_REPEAT_WINDUP_TIME +
+        1.0f / WEB_ASSIST_VISUAL_TETHER_EXTEND_RATE;
+    F32 cast_travel = horizontal_speed * predicted_cast_time;
+    F32 anchor_lead = bottom_lead + cast_travel;
+    F32 anchor_height = MAX(WEB_SKY_ANCHOR_HEIGHT,
+        bottom_lead * WEB_ASSIST_ANCHOR_HEIGHT_LEAD_RATIO);
+
+    copyVec3(ENTPOS(e), motion->web_swing_anchor);
+    scaleVec3(travel_intent, anchor_lead, lead);
+    addVec3(motion->web_swing_anchor, lead, motion->web_swing_anchor);
+    motion->web_swing_anchor[1] += anchor_height;
+    motion->web_swing_rope_length = distance3(ENTPOS(e), motion->web_swing_anchor);
+    candidate_low_point = motion->web_swing_anchor[1] - motion->web_swing_rope_length -
+                          WEB_ASSIST_ALTITUDE_ARC_DEPTH;
+    // The previous implementation could only raise this floor, which turned
+    // every release into another stair-step upward.  A chained pendulum needs
+    // the opposite property: preserve altitude when the new geometry would
+    // lift the floor, but allow a bounded amount of downward drift after the
+    // ballistic handoff so gravity can feed the next, deeper arc.
+    minimum_low_point = previous_low_point - WEB_ASSIST_ALTITUDE_FLOOR_MAX_FALL;
+    motion->web_swing_assist_low_point_y =
+        MAX(minimum_low_point, MIN(previous_low_point, candidate_low_point));
+    if(motion->web_swing_assist_low_point_y < previous_low_point - 0.01f)
+    {
+        filelog_printf("webswing.log",
+                       "WEB_SWING %s assisted_altitude_band event=LOWER cycle_id=%u previous_low_point_y=%.3f candidate_low_point_y=%.3f low_point_y=%.3f max_fall=%.3f energy=%.3f preserve_elevation=1\n",
+                       WEB_SWING_LOG_SIDE,
+                       motion->web_swing_assist_cycle_id,
+                       previous_low_point,
+                       candidate_low_point,
+                       motion->web_swing_assist_low_point_y,
+                       WEB_ASSIST_ALTITUDE_FLOOR_MAX_FALL,
+                       motion->web_swing_assist_energy);
+    }
+    filelog_printf("webswing.log",
+                   "WEB_SWING %s assisted_anchor_predict cycle_id=%u altitude_to_low=%.3f horizontal_speed=%.3f bottom_lead=%.3f cast_travel=%.3f anchor_lead=%.3f anchor_height=%.3f anchor=(%.2f %.2f %.2f) fixed_during_attached=1\n",
+                   WEB_SWING_LOG_SIDE,
+                   motion->web_swing_assist_cycle_id,
+                   altitude_to_low_point,
+                   horizontal_speed,
+                   bottom_lead,
+                   cast_travel,
+                   anchor_lead,
+                   anchor_height,
+                   vecParamsXYZ(motion->web_swing_anchor));
+}
+
+static void webSwingAssistedReleaseVisualTether(Entity *e, const Vec3 travel_intent)
+{
+    MotionState *motion = e->motion;
+    F32 horizontal_before;
+    F32 handoff_forward_boost;
+    F32 handoff_up_speed;
+    int launch_already_applied;
+
+    if(motion->web_swing_visual_tether_state != WEB_SWING_VISUAL_TETHER_ATTACHED)
+        return;
+
+    motion->web_swing_visual_tether_visible = 1;
+    motion->web_swing_visual_tether_state = WEB_SWING_VISUAL_TETHER_RETRACTING;
+    motion->web_swing_visual_tether_progress = 1.0f;
+    motion->web_swing_visual_tether_gap_ticks = 0;
+    motion->web_swing_visual_tether_shoot_ticks = 0;
+    motion->web_swing_visual_tether_shoot_time = 0.0f;
+    motion->web_swing_anim_catch_ticks = 0;
+
+    // The pendulum release is a real traversal launch, not merely a visual
+    // tether transition. Fire it at the apex so the character immediately
+    // enters a ballistic free-flight arc. The assisted pendulum controller is
+    // suspended while the old line retracts, the Freerunning stunt plays, and
+    // the replacement line casts; normal world gravity is the only vertical
+    // force until the new web visibly attaches.
+    launch_already_applied =
+        motion->web_swing_handoff_launch_segment_id == motion->web_swing_anim_segment_id;
+    horizontal_before = sqrt(SQR(motion->vel[0]) + SQR(motion->vel[2]));
+    // A clean chain earns a more expressive ballistic handoff.  The controller
+    // already accumulates assist_energy at each completed bottom sweep; use that
+    // same scalar as traversal "style" rather than handing every cycle the same
+    // fixed pop.  The bounded bonuses are deliberately small enough that the
+    // first swing remains readable while later swings gain real float and carry.
+    handoff_forward_boost = WEB_ASSIST_HANDOFF_FORWARD_BOOST +
+        motion->web_swing_assist_energy * WEB_ASSIST_HANDOFF_FORWARD_ENERGY_BOOST;
+    handoff_up_speed = WEB_ASSIST_HANDOFF_UP_SPEED +
+        motion->web_swing_assist_energy * WEB_ASSIST_HANDOFF_UP_ENERGY_SPEED;
+    if(!launch_already_applied)
+    {
+        // Capture the *actual* pendulum release height.  The previous version
+        // left this at the initial attach height, so every chained swing hit
+        // the emergency timeout rather than completing a deliberate pop-and-
+        // return ballistic arc.
+        motion->web_swing_handoff_release_y = ENTPOSY(e);
+        motion->web_swing_handoff_launch_segment_id = motion->web_swing_anim_segment_id;
+        motion->vel[0] += travel_intent[0] * handoff_forward_boost;
+        motion->vel[1] = MAX(motion->vel[1], handoff_up_speed);
+        motion->vel[2] += travel_intent[2] * handoff_forward_boost;
+    }
+    filelog_printf("webswing.log",
+                   "WEB_SWING %s visual_tether_release cycle_id=%u segment_id=%u phase=APEX anchor=(%.2f %.2f %.2f) retracting=1 free_flight=1\n",
+                   WEB_SWING_LOG_SIDE,
+                   motion->web_swing_assist_cycle_id,
+                   motion->web_swing_anim_segment_id,
+                   vecParamsXYZ(motion->web_swing_anchor));
+    filelog_printf("webswing.log",
+                   "WEB_SWING %s assisted_handoff_launch cycle_id=%u segment_id=%u forward_boost=%.3f up_speed=%.3f horizontal_before=%.3f horizontal_after=%.3f velocity=(%.3f %.3f %.3f) release_y=%.3f duplicate_suppressed=%d at_apex=1\n",
+                   WEB_SWING_LOG_SIDE,
+                   motion->web_swing_assist_cycle_id,
+                   motion->web_swing_anim_segment_id,
+                   handoff_forward_boost,
+                   handoff_up_speed,
+                   horizontal_before,
+                   sqrt(SQR(motion->vel[0]) + SQR(motion->vel[2])),
+                   vecParamsXYZ(motion->vel),
+                   motion->web_swing_handoff_release_y,
+                   launch_already_applied);
+}
+
+static void webSwingUpdateAssistedVisualTether(Entity *e, const Vec3 travel_intent)
+{
+    MotionState *motion = e->motion;
+    WebSwingAssistPhase phase = (WebSwingAssistPhase)motion->web_swing_assist_phase;
+    int replacement_cast =
+        motion->web_swing_handoff_launch_segment_id != 0 &&
+        motion->web_swing_handoff_launch_segment_id ==
+            motion->web_swing_anim_segment_id;
+    F32 shoot_windup_time = replacement_cast ?
+        WEB_ASSIST_VISUAL_TETHER_REPEAT_WINDUP_TIME :
+        WEB_ASSIST_VISUAL_TETHER_SHOOT_WINDUP_TIME;
+    switch((WebSwingVisualTetherState)motion->web_swing_visual_tether_state)
+    {
+        case WEB_SWING_VISUAL_TETHER_RETRACTING:
+            motion->web_swing_visual_tether_progress = MAX(0.0f,
+                motion->web_swing_visual_tether_progress -
+                WEB_ASSIST_VISUAL_TETHER_RETRACT_RATE * e->timestep);
+            if(motion->web_swing_visual_tether_progress <= 0.0f)
+            {
+                motion->web_swing_visual_tether_visible = 0;
+                motion->web_swing_visual_tether_state = WEB_SWING_VISUAL_TETHER_GAP;
+                motion->web_swing_visual_tether_gap_ticks = 0;
+                motion->web_swing_visual_tether_shoot_ticks = 0;
+                motion->web_swing_visual_tether_shoot_time = 0.0f;
+                motion->web_swing_anim_catch_ticks = 0;
+                filelog_printf("webswing.log",
+                               "WEB_SWING %s visual_tether_retracted cycle_id=%u segment_id=%u free_flight=1 boost_already_applied_at_apex=1\n",
+                               WEB_SWING_LOG_SIDE,
+                               motion->web_swing_assist_cycle_id,
+                               motion->web_swing_anim_segment_id);
+            }
+            break;
+
+        case WEB_SWING_VISUAL_TETHER_GAP:
+        {
+            int stunt_time_ready;
+            int descending_ready;
+            int release_height_ready;
+            int emergency_timeout;
+
+            ++motion->web_swing_visual_tether_gap_ticks;
+            stunt_time_ready =
+                motion->web_swing_visual_tether_gap_ticks >= WEB_ASSIST_VISUAL_TETHER_MIN_GAP_TICKS;
+            descending_ready = motion->vel[1] <= -WEB_ASSIST_RECAST_MIN_DESCENT_SPEED;
+            release_height_ready =
+                ENTPOSY(e) <= motion->web_swing_handoff_release_y +
+                              WEB_ASSIST_RECAST_RELEASE_HEIGHT_ALLOWANCE;
+            emergency_timeout =
+                motion->web_swing_visual_tether_gap_ticks >= WEB_ASSIST_VISUAL_TETHER_MAX_GAP_TICKS;
+            if(stunt_time_ready && descending_ready &&
+               (release_height_ready || emergency_timeout))
+            {
+                // Move the fictional endpoint only while the old web is
+                // invisible, then visibly shoot the new line outward.  The
+                // cast is deliberately velocity-gated rather than phase/tick
+                // gated: free flight leaves the assisted phase stale at APEX,
+                // and the old fixed-delay rule could therefore recast while
+                // the release boost was still carrying the player upward.
+                webSwingSetAssistedVisualAnchor(e, travel_intent);
+                motion->web_swing_visual_tether_visible = 1;
+                motion->web_swing_visual_tether_state = WEB_SWING_VISUAL_TETHER_EXTENDING;
+                motion->web_swing_visual_tether_progress = 0.0f;
+                motion->web_swing_visual_tether_shoot_ticks = 0;
+                motion->web_swing_visual_tether_shoot_time = 0.0f;
+                motion->web_swing_anim_catch_ticks = 0;
+                filelog_printf("webswing.log",
+                               "WEB_SWING %s visual_tether_attach cycle_id=%u segment_id=%u phase=%s gap_ticks=%u vertical_speed=%.3f recast_descent_gate=%.3f release_y=%.3f current_y=%.3f height_gate=%.3f height_allowance=%.3f emergency_timeout=%d replacement_cast=%d windup_time=%.3f anchor=(%.2f %.2f %.2f) physics_continuous=1\n",
+                               WEB_SWING_LOG_SIDE,
+                               motion->web_swing_assist_cycle_id,
+                               motion->web_swing_anim_segment_id,
+                               webSwingAssistPhaseName(phase),
+                               motion->web_swing_visual_tether_gap_ticks,
+                               motion->vel[1],
+                               -WEB_ASSIST_RECAST_MIN_DESCENT_SPEED,
+                               motion->web_swing_handoff_release_y,
+                                ENTPOSY(e),
+                                motion->web_swing_handoff_release_y +
+                                    WEB_ASSIST_RECAST_RELEASE_HEIGHT_ALLOWANCE,
+                                WEB_ASSIST_RECAST_RELEASE_HEIGHT_ALLOWANCE,
+                                emergency_timeout,
+                                replacement_cast,
+                                shoot_windup_time,
+                                vecParamsXYZ(motion->web_swing_anchor));
+            }
+            break;
+        }
+
+        case WEB_SWING_VISUAL_TETHER_EXTENDING:
+            ++motion->web_swing_visual_tether_shoot_ticks;
+            motion->web_swing_visual_tether_shoot_time += e->timestep;
+            // A fresh attach includes the authored wrist preparation. A
+            // replacement cast uses a short lead-in so the opposite hand has
+            // visibly entered its reach before the new line begins to grow.
+            if(motion->web_swing_visual_tether_shoot_time >
+               shoot_windup_time)
+            {
+                motion->web_swing_visual_tether_progress = MIN(1.0f,
+                    motion->web_swing_visual_tether_progress +
+                    WEB_ASSIST_VISUAL_TETHER_EXTEND_RATE * e->timestep);
+            }
+            if(motion->web_swing_visual_tether_progress >= 1.0f)
+            {
+                motion->web_swing_visual_tether_state = WEB_SWING_VISUAL_TETHER_ATTACHED;
+                motion->web_swing_anim_catch_ticks = 1;
+                filelog_printf("webswing.log",
+                               "WEB_SWING %s visual_tether_extended cycle_id=%u segment_id=%u shoot_ticks=%u shoot_time=%.3f windup_time=%.3f replacement_cast=%d physics_continuous=1\n",
+                               WEB_SWING_LOG_SIDE,
+                               motion->web_swing_assist_cycle_id,
+                               motion->web_swing_anim_segment_id,
+                                motion->web_swing_visual_tether_shoot_ticks,
+                                motion->web_swing_visual_tether_shoot_time,
+                                shoot_windup_time,
+                                replacement_cast);
+            }
+            break;
+
+        case WEB_SWING_VISUAL_TETHER_ATTACHED:
+            if(motion->web_swing_anim_catch_ticks > 0 &&
+               motion->web_swing_anim_catch_ticks <= WEB_ASSIST_ANIM_CATCH_TICKS)
+                ++motion->web_swing_anim_catch_ticks;
+            break;
+
+        default:
+            break;
+    }
+}
+
+static void webSwingApplyAssistedHorizontal(Entity *e, const Vec3 travel_intent,
+                                             WebSwingAssistPhase phase,
+                                             int preserve_momentum)
+{
+    MotionState *motion = e->motion;
+    Vec3 horizontal_velocity;
+    Vec3 target_velocity;
+    Vec3 velocity_delta;
+    F32 horizontal_speed;
+    F32 target_speed;
+    F32 steer_accel;
+    F32 max_delta;
+    F32 delta_length;
+
+    copyVec3(motion->vel, horizontal_velocity);
+    horizontal_velocity[1] = 0.0f;
+    horizontal_speed = lengthVec3(horizontal_velocity);
+
+    switch(phase)
+    {
+        case WEB_SWING_ASSIST_LAUNCH:
+            target_speed = MAX(horizontal_speed, WEB_ASSIST_LAUNCH_FORWARD_SPEED);
+            steer_accel = WEB_ASSIST_LAUNCH_ACCEL;
+            break;
+        case WEB_SWING_ASSIST_APEX:
+            target_speed = WEB_ASSIST_APEX_SPEED +
+                           motion->web_swing_assist_energy * WEB_ASSIST_APEX_ENERGY_SPEED;
+            steer_accel = WEB_ASSIST_STEER_APEX;
+            break;
+        case WEB_SWING_ASSIST_DESCEND:
+            target_speed = WEB_ASSIST_DESCEND_SPEED +
+                           motion->web_swing_assist_energy * WEB_ASSIST_DESCEND_ENERGY_SPEED;
+            steer_accel = WEB_ASSIST_STEER_DESCEND;
+            break;
+        case WEB_SWING_ASSIST_BOTTOM:
+            target_speed = WEB_ASSIST_BOTTOM_SPEED +
+                           motion->web_swing_assist_energy * WEB_ASSIST_BOTTOM_ENERGY_SPEED;
+            steer_accel = WEB_ASSIST_STEER_BOTTOM;
+            break;
+        default:
+            target_speed = WEB_ASSIST_ASCEND_SPEED +
+                           motion->web_swing_assist_energy * WEB_ASSIST_ASCEND_ENERGY_SPEED;
+            steer_accel = WEB_ASSIST_STEER_ASCEND;
+            break;
+    }
+    target_speed = MINMAX(target_speed, WEB_ASSIST_HORIZONTAL_MIN_SPEED,
+                          WEB_ASSIST_HORIZONTAL_MAX_SPEED);
+    if(preserve_momentum)
+        target_speed = MAX(horizontal_speed, target_speed);
+
+    scaleVec3(travel_intent, target_speed, target_velocity);
+    subVec3(target_velocity, horizontal_velocity, velocity_delta);
+    delta_length = lengthVec3(velocity_delta);
+    max_delta = steer_accel * e->timestep;
+    if(delta_length > max_delta && delta_length > 0.0001f)
+        scaleVec3(velocity_delta, max_delta / delta_length, velocity_delta);
+    motion->vel[0] += velocity_delta[0];
+    motion->vel[2] += velocity_delta[2];
+}
+
+static void webSwingAssistedBeginSwoop(Entity *e)
+{
+    MotionState *motion = e->motion;
+    F32 horizontal_speed = sqrt(SQR(motion->vel[0]) + SQR(motion->vel[2]));
+    F32 plane_speed = sqrt(SQR(horizontal_speed) + SQR(motion->vel[1]));
+    F32 desired_radius = MINMAX(
+        motion->web_swing_rope_length * WEB_ASSIST_SWOOP_ROPE_RADIUS_SCALE,
+        WEB_ASSIST_SWOOP_DEFAULT_RADIUS,
+        WEB_ASSIST_SWOOP_MAX_RADIUS);
+
+    motion->web_swing_assist_swoop_active = 1;
+    motion->web_swing_assist_swoop_entry_plane_speed =
+        MIN(plane_speed, WEB_ASSIST_TOTAL_MAX_SPEED);
+    motion->web_swing_assist_swoop_entry_angle =
+        atan2(motion->vel[1], MAX(horizontal_speed, 0.0001f));
+    motion->web_swing_assist_swoop_radius = desired_radius;
+    filelog_printf("webswing.log",
+                   "WEB_SWING %s assisted_swoop_begin tick=%u cycle_id=%u entry_angle_deg=%.3f entry_plane_speed=%.3f horizontal_speed=%.3f vertical_speed=%.3f rope=%.3f desired_radius=%.3f\n",
+                   WEB_SWING_LOG_SIDE,
+                   motion->tickCounter,
+                   motion->web_swing_assist_cycle_id,
+                   DEG(motion->web_swing_assist_swoop_entry_angle),
+                   motion->web_swing_assist_swoop_entry_plane_speed,
+                   horizontal_speed,
+                   motion->vel[1],
+                   motion->web_swing_rope_length,
+                   desired_radius);
+}
+
+static int webSwingApplyAssistedSwoop(Entity *e, const Vec3 travel_intent,
+                                      WebSwingAssistPhase phase, F32 clearance)
+{
+    MotionState *motion = e->motion;
+    Vec3 horizontal_direction;
+    F32 horizontal_speed;
+    F32 plane_speed;
+    F32 swing_angle;
+    F32 target_angle;
+    F32 selected_radius = motion->web_swing_assist_swoop_radius;
+    F32 desired_radius = MINMAX(
+        motion->web_swing_rope_length * WEB_ASSIST_SWOOP_ROPE_RADIUS_SCALE,
+        WEB_ASSIST_SWOOP_DEFAULT_RADIUS,
+        WEB_ASSIST_SWOOP_MAX_RADIUS);
+    F32 safe_radius = desired_radius;
+    F32 available_drop = FLT_MAX;
+    F32 angular_step;
+    F32 horizontal_ratio;
+    F32 redirect_strength;
+    F32 new_angle;
+    F32 new_horizontal_speed;
+    int terrain_emergency = 0;
+
+    copyVec3(motion->vel, horizontal_direction);
+    horizontal_direction[1] = 0.0f;
+    horizontal_speed = lengthVec3(horizontal_direction);
+    plane_speed = sqrt(SQR(horizontal_speed) + SQR(motion->vel[1]));
+    if(plane_speed < WEB_ASSIST_SWOOP_MIN_PLANE_SPEED)
+        return 0;
+
+    if(horizontal_speed > 0.0001f)
+        scaleVec3(horizontal_direction, 1.0f / horizontal_speed, horizontal_direction);
+    else
+        copyVec3(travel_intent, horizontal_direction);
+
+    swing_angle = atan2(motion->vel[1], MAX(horizontal_speed, 0.0001f));
+    target_angle = phase == WEB_SWING_ASSIST_BOTTOM ? 0.0f :
+                   WEB_ASSIST_SWOOP_EXIT_ANGLE;
+
+    if(phase == WEB_SWING_ASSIST_BOTTOM && swing_angle < 0.0f)
+    {
+        F32 denominator = 1.0f - cos(fabs(swing_angle));
+        F32 altitude_available = ENTPOSY(e) -
+            motion->web_swing_assist_low_point_y -
+            WEB_ASSIST_ALTITUDE_TRANSITION_PADDING;
+
+        available_drop = altitude_available;
+        if(clearance >= 0.0f && clearance < WEB_ASSIST_GROUND_PROBE_DISTANCE)
+        {
+            available_drop = MIN(available_drop,
+                clearance - WEB_ASSIST_GROUND_TARGET_CLEARANCE -
+                WEB_ASSIST_GROUND_TRANSITION_PADDING);
+        }
+
+        if(denominator > 0.0001f)
+            safe_radius = available_drop / denominator;
+        selected_radius = MIN(desired_radius, safe_radius);
+        if(selected_radius < WEB_ASSIST_SWOOP_MIN_RADIUS)
+        {
+            selected_radius = WEB_ASSIST_SWOOP_MIN_RADIUS;
+            terrain_emergency = 1;
+        }
+        motion->web_swing_assist_swoop_radius = selected_radius;
+    }
+
+    horizontal_ratio = horizontal_speed / plane_speed;
+    redirect_strength = MINMAX(
+        (horizontal_ratio - WEB_ASSIST_SWOOP_HORIZONTAL_BLEND_START) /
+        (WEB_ASSIST_SWOOP_HORIZONTAL_BLEND_FULL -
+         WEB_ASSIST_SWOOP_HORIZONTAL_BLEND_START),
+        0.0f, 1.0f);
+    redirect_strength = redirect_strength * redirect_strength *
+        (3.0f - 2.0f * redirect_strength);
+
+    angular_step = MIN(WEB_ASSIST_SWOOP_MAX_ANGULAR_STEP,
+        plane_speed / MAX(selected_radius, WEB_ASSIST_SWOOP_MIN_RADIUS) *
+        MAX(e->timestep, 0.0f));
+    angular_step *= redirect_strength;
+    new_angle = MIN(target_angle, swing_angle + angular_step);
+
+    if(redirect_strength > 0.0f && new_angle > swing_angle)
+    {
+        new_horizontal_speed = plane_speed * cos(new_angle);
+        motion->vel[0] = horizontal_direction[0] * new_horizontal_speed;
+        motion->vel[2] = horizontal_direction[2] * new_horizontal_speed;
+        motion->vel[1] = plane_speed * sin(new_angle);
+    }
+
+    if(phase == WEB_SWING_ASSIST_BOTTOM)
+    {
+        F32 downward_speed = MAX(0.0f, -motion->vel[1]);
+        int inside_unsafe_clearance =
+            (clearance >= 0.0f && clearance < WEB_ASSIST_GROUND_PROBE_DISTANCE &&
+             clearance <= WEB_ASSIST_GROUND_TARGET_CLEARANCE +
+                          WEB_ASSIST_SWOOP_EMERGENCY_MARGIN) ||
+            ENTPOSY(e) <= motion->web_swing_assist_low_point_y +
+                          WEB_ASSIST_SWOOP_EMERGENCY_MARGIN;
+
+        if(downward_speed > 0.25f &&
+           (terrain_emergency || inside_unsafe_clearance))
+        {
+            F32 emergency_room = MAX(0.5f, available_drop);
+            F32 required_accel = downward_speed * downward_speed /
+                                 (2.0f * emergency_room);
+            F32 emergency_accel = MIN(WEB_ASSIST_SWOOP_EMERGENCY_MAX_ACCEL,
+                MAX(WEB_ASSIST_SWOOP_EMERGENCY_BASE_ACCEL, required_accel));
+            F32 applied_correction = emergency_accel * e->timestep;
+
+            motion->vel[1] += applied_correction;
+            ++motion->web_swing_assist_swoop_emergency_count;
+            filelog_printf("webswing.log",
+                           "WEB_SWING %s assisted_swoop_emergency tick=%u cycle_id=%u clearance=%.3f angle_deg=%.3f plane_speed=%.3f required_radius=%.3f selected_radius=%.3f available_drop=%.3f applied_correction=%.3f emergency_count=%u\n",
+                           WEB_SWING_LOG_SIDE,
+                           motion->tickCounter,
+                           motion->web_swing_assist_cycle_id,
+                           clearance,
+                           DEG(swing_angle),
+                           plane_speed,
+                           safe_radius,
+                           selected_radius,
+                           available_drop,
+                           applied_correction,
+                           motion->web_swing_assist_swoop_emergency_count);
+        }
+    }
+
+    if(new_angle >= target_angle - 0.0001f)
+    {
+        if(phase == WEB_SWING_ASSIST_ASCEND)
+        {
+            motion->web_swing_assist_swoop_active = 0;
+            filelog_printf("webswing.log",
+                           "WEB_SWING %s assisted_swoop_exit tick=%u cycle_id=%u exit_angle_deg=%.3f plane_speed=%.3f horizontal_speed=%.3f radius=%.3f emergency_count=%u\n",
+                           WEB_SWING_LOG_SIDE,
+                           motion->tickCounter,
+                           motion->web_swing_assist_cycle_id,
+                           DEG(new_angle),
+                           lengthVec3(motion->vel),
+                           sqrt(SQR(motion->vel[0]) + SQR(motion->vel[2])),
+                           motion->web_swing_assist_swoop_radius,
+                           motion->web_swing_assist_swoop_emergency_count);
+        }
+        return 1;
+    }
+
+    return 0;
+}
+
+static void webSwingApplyAssistedController(Entity *e)
+{
+    MotionState *motion = e->motion;
+    WebSwingAssistPhase phase = (WebSwingAssistPhase)motion->web_swing_assist_phase;
+    U32 visual_state_before_update;
+    Vec3 travel_intent;
+    F32 horizontal_input_magnitude = 0.0f;
+    F32 clearance;
+    F32 downward_speed;
+    F32 bottom_threshold;
+    F32 horizontal_speed;
+    F32 current_clearance;
+    F32 ahead_clearance;
+    F32 lookahead_distance;
+    F32 speed;
+    F32 altitude_trigger_y;
+    F32 stopping_distance;
+    F32 altitude_stopping_distance;
+
+    // The controller already computes these values below.  Keep a cheap copy
+    // for client-side manual capture instead of repeating terrain probes.
+    motion->web_swing_assist_current_clearance = -1.0f;
+    motion->web_swing_assist_ahead_clearance = -1.0f;
+    motion->web_swing_assist_lookahead_distance = -1.0f;
+    motion->web_swing_assist_altitude_margin =
+        ENTPOSY(e) - motion->web_swing_assist_low_point_y;
+
+    if(phase == WEB_SWING_ASSIST_NONE)
+        webSwingAssistedBegin(e, !motion->falling && !motion->jumping);
+    phase = (WebSwingAssistPhase)motion->web_swing_assist_phase;
+    motion->web_swing_assist_altitude_margin =
+        ENTPOSY(e) - motion->web_swing_assist_low_point_y;
+    ++motion->web_swing_assist_phase_ticks;
+
+    webSwingGetTravelIntent(e, travel_intent, &horizontal_input_magnitude);
+    if(lengthVec3Squared(travel_intent) < 0.0001f)
+        return;
+
+    horizontal_speed = sqrt(SQR(motion->vel[0]) + SQR(motion->vel[2]));
+    lookahead_distance = MIN(WEB_ASSIST_GROUND_LOOKAHEAD_MAX,
+                             WEB_ASSIST_GROUND_LOOKAHEAD_BASE +
+                             horizontal_speed * WEB_ASSIST_GROUND_LOOKAHEAD_SPEED);
+    {
+        Vec3 ahead_position;
+        Vec3 half_ahead_position;
+
+        copyVec3(ENTPOS(e), ahead_position);
+        ahead_position[0] += travel_intent[0] * lookahead_distance;
+        ahead_position[2] += travel_intent[2] * lookahead_distance;
+        copyVec3(ENTPOS(e), half_ahead_position);
+        half_ahead_position[0] += travel_intent[0] * lookahead_distance * 0.5f;
+        half_ahead_position[2] += travel_intent[2] * lookahead_distance * 0.5f;
+        current_clearance = HeightAtLoc(ENTPOS(e), DEFAULT_RADIUS, WEB_ASSIST_GROUND_PROBE_DISTANCE);
+        ahead_clearance = MIN(HeightAtLoc(half_ahead_position, DEFAULT_RADIUS, WEB_ASSIST_GROUND_PROBE_DISTANCE),
+                              HeightAtLoc(ahead_position, DEFAULT_RADIUS, WEB_ASSIST_GROUND_PROBE_DISTANCE));
+        clearance = MIN(current_clearance, ahead_clearance);
+    }
+    motion->web_swing_assist_current_clearance = current_clearance;
+    motion->web_swing_assist_ahead_clearance = ahead_clearance;
+    motion->web_swing_assist_lookahead_distance = lookahead_distance;
+    motion->web_swing_assist_altitude_margin =
+        ENTPOSY(e) - motion->web_swing_assist_low_point_y;
+    visual_state_before_update = motion->web_swing_visual_tether_state;
+    webSwingUpdateAssistedVisualTether(e, travel_intent);
+
+    if(visual_state_before_update != WEB_SWING_VISUAL_TETHER_ATTACHED &&
+       motion->web_swing_visual_tether_state == WEB_SWING_VISUAL_TETHER_ATTACHED)
+    {
+        WebSwingAssistPhase resume_phase = motion->vel[1] > 0.20f ?
+            WEB_SWING_ASSIST_ASCEND :
+            (motion->vel[1] < -0.20f ? WEB_SWING_ASSIST_DESCEND : WEB_SWING_ASSIST_APEX);
+        F32 forward_speed_before =
+            motion->vel[0] * travel_intent[0] + motion->vel[2] * travel_intent[2];
+        F32 forward_delta = MAX(0.0f,
+            WEB_ASSIST_AIR_ATTACH_FORWARD_SPEED - forward_speed_before);
+        F32 cast_rope_length = motion->web_swing_rope_length;
+        F32 settled_rope_length = MINMAX(
+            distance3(ENTPOS(e), motion->web_swing_anchor),
+            WEB_MIN_ROPE_LENGTH, WEB_MAX_ROPE_LENGTH);
+        F32 rope_growth = MAX(0.0f, settled_rope_length - cast_rope_length);
+
+        // Cast first, attach second, swing third.  Until the visual line has
+        // actually reached its endpoint the character remains in ordinary
+        // ballistic jump/free-flight motion.  The forward conversion happens
+        // here, on attachment, so the second Space press does not shove the
+        // character forward before a web exists.
+        motion->vel[0] += travel_intent[0] * forward_delta;
+        motion->vel[2] += travel_intent[2] * forward_delta;
+        if(rope_growth > 0.01f)
+        {
+            // The character remains ballistic while the line is visibly
+            // extending.  If they fall farther from the fixed endpoint during
+            // that cast, the connected web is physically longer than it was at
+            // button-down.  Preserve that distance instead of snapping the
+            // assisted pendulum back to the stale short cast-time length.
+            motion->web_swing_rope_length = settled_rope_length;
+            motion->web_swing_assist_initial_low_point_y -= rope_growth;
+            motion->web_swing_assist_low_point_y -= rope_growth;
+            filelog_printf("webswing.log",
+                           "WEB_SWING %s assisted_rope_settle_growth cycle_id=%u cast_rope=%.3f settled_rope=%.3f growth=%.3f low_point_y=%.3f player_y=%.3f anchor_y=%.3f\n",
+                           WEB_SWING_LOG_SIDE,
+                           motion->web_swing_assist_cycle_id,
+                           cast_rope_length,
+                           settled_rope_length,
+                           rope_growth,
+                           motion->web_swing_assist_low_point_y,
+                           ENTPOSY(e),
+                           motion->web_swing_anchor[1]);
+        }
+        webSwingAssistedSetPhase(e, resume_phase, "VISUAL_WEB_ATTACHED");
+        phase = resume_phase;
+        filelog_printf("webswing.log",
+                       "WEB_SWING %s assisted_visual_attach_commit cycle_id=%u segment_id=%u forward_before=%.3f forward_target=%.3f forward_delta=%.3f vertical_preserved=%.3f resume_phase=%s velocity=(%.3f %.3f %.3f)\n",
+                       WEB_SWING_LOG_SIDE,
+                       motion->web_swing_assist_cycle_id,
+                       motion->web_swing_anim_segment_id,
+                       forward_speed_before,
+                       WEB_ASSIST_AIR_ATTACH_FORWARD_SPEED,
+                       forward_delta,
+                       motion->vel[1],
+                       webSwingAssistPhaseName(resume_phase),
+                       vecParamsXYZ(motion->vel));
+    }
+
+    // Any visible-web transition is true free flight.  Retraction, the no-web
+    // stunt gap, and the replacement cast all run under ordinary world gravity
+    // with no pendulum horizontal/vertical assist.  This creates the physical
+    // breathing room for Freerunning flips and makes the next attachment a
+    // distinct event instead of continuing DESCEND behind the animation.
+    if(motion->web_swing_visual_tether_state != WEB_SWING_VISUAL_TETHER_ATTACHED)
+    {
+        ++motion->web_swing_log_tick;
+        if(motion->web_swing_log_tick >= 15)
+        {
+            filelog_printf("webswing.log",
+                           "WEB_SWING %s assisted_free_flight web_state=%u phase=%s phase_ticks=%u cycle_id=%u gap_ticks=%u velocity=(%.3f %.3f %.3f) controller_suspended=1\n",
+                           WEB_SWING_LOG_SIDE,
+                           motion->web_swing_visual_tether_state,
+                           webSwingAssistPhaseName((WebSwingAssistPhase)motion->web_swing_assist_phase),
+                           motion->web_swing_assist_phase_ticks,
+                           motion->web_swing_assist_cycle_id,
+                           motion->web_swing_visual_tether_gap_ticks,
+                           vecParamsXYZ(motion->vel));
+            motion->web_swing_log_tick = 0;
+        }
+        return;
+    }
+
+    /* A visible attached web is a world-space pendulum reference, even though
+       SKY_ASSISTED does not use it as a rigid physics pivot.  Do not chase the
+       player with the endpoint here: doing so keeps the line permanently ahead
+       of travel (visually '/' but never '\\').  The endpoint is authored once
+       when the cast begins, remains fixed through ATTACHED, and is replaced only
+       while the old line is gone in webSwingSetAssistedVisualAnchor(). */
+    motion->web_swing_assist_altitude_margin =
+        ENTPOSY(e) - motion->web_swing_assist_low_point_y;
+
+    // Physics starts with the activation while the authored wrist shot and
+    // visible tether extension continue concurrently.  LAUNCH still owns one
+    // boost only; presentation readiness is not a movement gate.
+    if(phase == WEB_SWING_ASSIST_LAUNCH)
+    {
+        F32 forward_component = motion->vel[0] * travel_intent[0] +
+                                motion->vel[2] * travel_intent[2];
+        F32 forward_delta = MAX(0.0f, WEB_ASSIST_LAUNCH_FORWARD_SPEED - forward_component);
+        motion->vel[1] = MAX(motion->vel[1], WEB_ASSIST_LAUNCH_UP_SPEED);
+        motion->vel[0] += travel_intent[0] * forward_delta;
+        motion->vel[2] += travel_intent[2] * forward_delta;
+        filelog_printf("webswing.log",
+                       "WEB_SWING %s ground_boost tick=%u cycle_id=%u activation_latency_ticks=0 up_speed=%.3f forward_speed=%.3f velocity=(%.3f %.3f %.3f) web_progress=%.3f web_state=%u presentation_independent=1 one_shot=1\n",
+                       WEB_SWING_LOG_SIDE,
+                       motion->tickCounter,
+                       motion->web_swing_assist_cycle_id,
+                       motion->vel[1],
+                       sqrt(SQR(motion->vel[0]) + SQR(motion->vel[2])),
+                       vecParamsXYZ(motion->vel),
+                       motion->web_swing_visual_tether_progress,
+                       motion->web_swing_visual_tether_state);
+        webSwingAssistedSetPhase(e, WEB_SWING_ASSIST_ASCEND, "IMMEDIATE_PHYSICS");
+        phase = WEB_SWING_ASSIST_ASCEND;
+    }
+    webSwingApplyAssistedHorizontal(e, travel_intent, phase,
+        phase == WEB_SWING_ASSIST_BOTTOM ||
+        (phase == WEB_SWING_ASSIST_ASCEND &&
+         motion->web_swing_assist_cycle_id > 1));
+
+    switch(phase)
+    {
+        case WEB_SWING_ASSIST_LAUNCH:
+            // LAUNCH always resolves to ASCEND above on its first update.
+            break;
+
+        case WEB_SWING_ASSIST_ASCEND:
+        {
+            Vec3 tether_to_anchor;
+            F32 anchor_forward_lead;
+            F32 anchor_vertical;
+            F32 trailing_angle = 0.0f;
+            U32 release_min_ticks =
+                motion->web_swing_assist_cycle_id == 2 ?
+                WEB_ASSIST_TETHER_RELEASE_OPENING_MIN_TICKS :
+                WEB_ASSIST_TETHER_RELEASE_MIN_TICKS;
+
+            if(motion->web_swing_assist_swoop_active)
+            {
+                webSwingApplyAssistedSwoop(e, travel_intent, phase, clearance);
+            }
+            else
+            {
+                motion->vel[1] += (WEB_ASSIST_ASCEND_GRAVITY_ASSIST +
+                                   motion->web_swing_assist_energy *
+                                   WEB_ASSIST_ASCEND_ENERGY_ASSIST) *
+                                  e->timestep;
+            }
+            // Once the character has passed beneath a fixed endpoint, let the
+            // actual tether geometry decide when the pendulum has expressed a
+            // readable forward upswing.  C50 released at ~35 degrees and made
+            // the authored upswing almost unreadable.  C51 deliberately carries
+            // the attached line to ~50 degrees and requires a longer minimum
+            // ASCEND window so the whole-body pose is visible before release.
+            subVec3(motion->web_swing_anchor, ENTPOS(e), tether_to_anchor);
+            anchor_forward_lead =
+                tether_to_anchor[0] * travel_intent[0] +
+                tether_to_anchor[2] * travel_intent[2];
+            anchor_vertical = tether_to_anchor[1];
+            if(motion->web_swing_assist_cycle_id > 1 &&
+               motion->web_swing_assist_phase_ticks >= release_min_ticks &&
+               anchor_forward_lead < 0.0f && anchor_vertical > 1.0f)
+            {
+                trailing_angle = atan2(-anchor_forward_lead, anchor_vertical);
+                if(trailing_angle >= WEB_ASSIST_TETHER_RELEASE_ANGLE)
+                {
+                    motion->web_swing_assist_swoop_active = 0;
+                    filelog_printf("webswing.log",
+                                   "WEB_SWING %s assisted_tether_angle_release tick=%u cycle_id=%u phase_ticks=%u release_min_ticks=%u lead=%.3f vertical=%.3f angle_deg=%.3f target_deg=%.3f velocity=(%.3f %.3f %.3f)\n",
+                                   WEB_SWING_LOG_SIDE,
+                                   motion->tickCounter,
+                                   motion->web_swing_assist_cycle_id,
+                                   motion->web_swing_assist_phase_ticks,
+                                   release_min_ticks,
+                                   anchor_forward_lead,
+                                   anchor_vertical,
+                                   DEG(trailing_angle),
+                                   DEG(WEB_ASSIST_TETHER_RELEASE_ANGLE),
+                                   vecParamsXYZ(motion->vel));
+                    webSwingAssistedSetPhase(e, WEB_SWING_ASSIST_APEX,
+                                             "TETHER_FORWARD_ANGLE");
+                    webSwingAssistedReleaseVisualTether(e, travel_intent);
+                    break;
+                }
+            }
+            // The swoop is a shaping aid, not a second definition of whether
+            // the character is still ascending.  A long-radius swoop can fail
+            // to reach its synthetic +36-degree exit angle before world
+            // gravity turns the real trajectory downward.  Previously that
+            // left the controller permanently labeled ASCEND while the player
+            // was visibly falling.  Once a real ascent has had a short window
+            // to establish itself, physical vertical turnover wins: abandon
+            // the residual swoop and let APEX own the release/free-flight arc.
+            if(motion->web_swing_assist_swoop_active &&
+               motion->web_swing_assist_phase_ticks >= WEB_ASSIST_SWOOP_TURNOVER_MIN_TICKS &&
+               motion->vel[1] <= -WEB_ASSIST_SWOOP_TURNOVER_DOWN_SPEED)
+            {
+                motion->web_swing_assist_swoop_active = 0;
+                filelog_printf("webswing.log",
+                               "WEB_SWING %s assisted_swoop_turnover_recovery tick=%u cycle_id=%u phase_ticks=%u vertical_speed=%.3f physical_turnover=1\n",
+                               WEB_SWING_LOG_SIDE,
+                               motion->tickCounter,
+                               motion->web_swing_assist_cycle_id,
+                               motion->web_swing_assist_phase_ticks,
+                               motion->vel[1]);
+            }
+            if(!motion->web_swing_assist_swoop_active && motion->vel[1] <= 0.20f &&
+               (motion->web_swing_assist_cycle_id != 2 ||
+                motion->web_swing_assist_phase_ticks >= release_min_ticks))
+            {
+                webSwingAssistedSetPhase(e, WEB_SWING_ASSIST_APEX, "VERTICAL_TURNOVER");
+                webSwingAssistedReleaseVisualTether(e, travel_intent);
+            }
+            break;
+        }
+
+        case WEB_SWING_ASSIST_APEX:
+            motion->vel[1] -= WEB_ASSIST_APEX_DOWN_ACCEL * e->timestep;
+            if(motion->web_swing_assist_phase_ticks >= 5 || motion->vel[1] <= -0.20f)
+                webSwingAssistedSetPhase(e, WEB_SWING_ASSIST_DESCEND, "APEX_COMPLETE");
+            break;
+
+        case WEB_SWING_ASSIST_DESCEND:
+            motion->vel[1] -= (WEB_ASSIST_DESCEND_DOWN_ACCEL +
+                               motion->web_swing_assist_energy * WEB_ASSIST_DESCEND_ENERGY_ACCEL) *
+                              e->timestep;
+            downward_speed = MAX(0.0f, -motion->vel[1]);
+            stopping_distance = downward_speed * downward_speed /
+                                (2.0f * WEB_ASSIST_GROUND_STOP_ACCEL);
+            altitude_stopping_distance = downward_speed * downward_speed /
+                                         (2.0f * WEB_ASSIST_ALTITUDE_STOP_ACCEL);
+            bottom_threshold = WEB_ASSIST_GROUND_TARGET_CLEARANCE +
+                               WEB_ASSIST_GROUND_TRANSITION_PADDING +
+                               stopping_distance;
+            bottom_threshold = MIN(bottom_threshold, WEB_ASSIST_GROUND_PROBE_DISTANCE - 1.0f);
+            altitude_trigger_y = motion->web_swing_assist_low_point_y +
+                                 WEB_ASSIST_ALTITUDE_TRANSITION_PADDING +
+                                 altitude_stopping_distance;
+            if(clearance <= bottom_threshold || ENTPOSY(e) <= altitude_trigger_y)
+            {
+                const char *bottom_reason = ENTPOSY(e) <= altitude_trigger_y &&
+                                            clearance > bottom_threshold ?
+                                            "ALTITUDE_BAND" : "GROUND_ANTICIPATION";
+                motion->web_swing_assist_energy = MIN(WEB_ASSIST_MAX_ENERGY,
+                    motion->web_swing_assist_energy + WEB_ASSIST_ENERGY_PER_CYCLE);
+                filelog_printf("webswing.log",
+                               "WEB_SWING %s assisted_bottom_guard reason=%s cycle_id=%u pos_y=%.3f low_point_y=%.3f altitude_trigger_y=%.3f altitude_stopping_distance=%.3f clearance=%.3f terrain_threshold=%.3f downward_speed=%.3f\n",
+                               WEB_SWING_LOG_SIDE,
+                               bottom_reason,
+                               motion->web_swing_assist_cycle_id,
+                               ENTPOSY(e),
+                               motion->web_swing_assist_low_point_y,
+                               altitude_trigger_y,
+                               altitude_stopping_distance,
+                               clearance,
+                               bottom_threshold,
+                               downward_speed);
+                webSwingAssistedBeginSwoop(e);
+                webSwingAssistedSetPhase(e, WEB_SWING_ASSIST_BOTTOM, bottom_reason);
+            }
+            break;
+
+        case WEB_SWING_ASSIST_BOTTOM:
+        {
+            if(webSwingApplyAssistedSwoop(e, travel_intent, phase, clearance))
+            {
+                Vec3 rebound_horizontal_direction;
+                F32 rebound_plane_speed = lengthVec3(motion->vel);
+                F32 rebound_horizontal_speed =
+                    sqrt(SQR(motion->vel[0]) + SQR(motion->vel[2]));
+                F32 rebound_vertical_unclamped = rebound_plane_speed *
+                    sin(WEB_ASSIST_SWOOP_EXIT_ANGLE);
+                // Preserve the authored pendulum angle as the run gains energy.
+                // The old fixed 2.5 up-speed ceiling forced fast swings flatter
+                // and flatter (roughly 34deg -> 20deg in live telemetry), which
+                // hid the very height/momentum progression the energy model was
+                // accumulating.  Let earned energy raise the vertical ceiling so
+                // fast bottoms convert into visibly higher forward arcs.
+                F32 rebound_vertical_cap = MIN(
+                    WEB_ASSIST_BOTTOM_REBOUND_MAX_UP_SPEED,
+                    WEB_ASSIST_BOTTOM_REBOUND_BASE_UP_SPEED +
+                    motion->web_swing_assist_energy *
+                    WEB_ASSIST_BOTTOM_REBOUND_ENERGY_UP_SPEED);
+                F32 rebound_vertical_after = MIN(rebound_vertical_unclamped,
+                    rebound_vertical_cap);
+                F32 rebound_horizontal_after = sqrt(MAX(0.0f,
+                    SQR(rebound_plane_speed) - SQR(rebound_vertical_after)));
+                F32 rebound_plane_speed_after;
+                F32 rebound_angle_after;
+                int rebound_vertical_capped =
+                    rebound_vertical_after < rebound_vertical_unclamped - 0.0001f;
+
+                copyVec3(motion->vel, rebound_horizontal_direction);
+                rebound_horizontal_direction[1] = 0.0f;
+                if(rebound_horizontal_speed > 0.0001f)
+                {
+                    scaleVec3(rebound_horizontal_direction,
+                              1.0f / rebound_horizontal_speed,
+                              rebound_horizontal_direction);
+                }
+                else
+                {
+                    copyVec3(travel_intent, rebound_horizontal_direction);
+                }
+                motion->vel[0] = rebound_horizontal_direction[0] *
+                                 rebound_horizontal_after;
+                motion->vel[2] = rebound_horizontal_direction[2] *
+                                 rebound_horizontal_after;
+                motion->vel[1] = rebound_vertical_after;
+                rebound_plane_speed_after = lengthVec3(motion->vel);
+                rebound_angle_after = atan2(rebound_vertical_after,
+                    MAX(rebound_horizontal_after, 0.0001f));
+                motion->web_swing_assist_swoop_active = 0;
+
+                ++motion->web_swing_assist_cycle_id;
+                ++motion->web_swing_anim_segment_id;
+                filelog_printf("webswing.log",
+                               "WEB_SWING %s assisted_bottom_rebound cycle_id=%u segment_id=%u pre_plane_speed=%.3f post_plane_speed=%.3f requested_angle_deg=%.3f applied_angle_deg=%.3f pre_horizontal_speed=%.3f post_horizontal_speed=%.3f vertical_unclamped=%.3f vertical_cap=%.3f vertical_applied=%.3f vertical_capped=%d preserve_plane_speed=1 energy_added=0\n",
+                               WEB_SWING_LOG_SIDE,
+                               motion->web_swing_assist_cycle_id,
+                               motion->web_swing_anim_segment_id,
+                               rebound_plane_speed,
+                               rebound_plane_speed_after,
+                               DEG(WEB_ASSIST_SWOOP_EXIT_ANGLE),
+                               DEG(rebound_angle_after),
+                               rebound_horizontal_speed,
+                               rebound_horizontal_after,
+                               rebound_vertical_unclamped,
+                    rebound_vertical_cap,
+                               rebound_vertical_after,
+                               rebound_vertical_capped);
+                filelog_printf("webswing.log",
+                               "WEB_SWING %s assisted_cycle cycle_id=%u segment_id=%u energy=%.3f zero_cross=1 swoop_radius=%.3f entry_plane_speed=%.3f clearance=%.3f pos=(%.2f %.2f %.2f) velocity=(%.3f %.3f %.3f) preserve_plane_speed=1 preserve_horizontal=1\n",
+                               WEB_SWING_LOG_SIDE,
+                               motion->web_swing_assist_cycle_id,
+                               motion->web_swing_anim_segment_id,
+                               motion->web_swing_assist_energy,
+                               motion->web_swing_assist_swoop_radius,
+                               motion->web_swing_assist_swoop_entry_plane_speed,
+                               clearance,
+                               vecParamsXYZ(ENTPOS(e)),
+                               vecParamsXYZ(motion->vel));
+                webSwingAssistedSetPhase(e, WEB_SWING_ASSIST_ASCEND, "BOTTOM_SWEEP_COMPLETE");
+            }
+            break;
+        }
