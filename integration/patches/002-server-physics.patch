+void entWorldWebSwingUpdateAttachment(Entity *e, int web_swing_test_no_attach)
+{
+    MotionState *motion = e->motion;
+    int enabled = motion->input.web_swing_enabled;
+    int held = enabled && motion->input.web_swing_jump_button_down;
+    int airborne = motion->falling || motion->jumping;
+    int pressed = held && !motion->web_swing_jump_button_was_down;
+    int released = !held && motion->web_swing_jump_button_was_down;
+    int fresh_air_attach_request;
+    int selected_backend = motion->input.web_swing_backend ?
+        WEB_SWING_BACKEND_SKY_ASSISTED : WEB_SWING_BACKEND_REAL_ANCHOR;
+
+    // Two-press traversal contract:
+    //   first physical Space DOWN = ordinary enhanced jump only
+    //   physical Space UP         = arm the cast
+    //   second physical Space DOWN while airborne = cast/attach request
+    // This intentionally uses a raw button edge rather than jump_still_held or
+    // input.vel[1].  Both of those are mutated by normal CoH jump-repeat and
+    // variable-height behavior and previously allowed one continuous hold to
+    // masquerade as the second press.
+    if(!enabled)
+    {
+        motion->web_swing_second_press_armed = 0;
+    }
+    else if(!motion->web_swing_attached)
+    {
+        if(!airborne)
+        {
+            motion->web_swing_second_press_armed = 0;
+        }
+        else if(released)
+        {
+            motion->web_swing_second_press_armed = 1;
+            filelog_printf("webswing.log",
+                           "WEB_SWING %s input_second_press_armed tick=%u vertical_speed=%.3f\n",
+                           WEB_SWING_LOG_SIDE,
+                           motion->tickCounter,
+                           motion->vel[1]);
+        }
+    }
+
+    fresh_air_attach_request =
+        enabled && pressed && airborne && motion->web_swing_second_press_armed;
+    if(fresh_air_attach_request)
+    {
+        motion->web_swing_second_press_armed = 0;
+        filelog_printf("webswing.log",
+                       "WEB_SWING %s input_second_press_cast tick=%u vertical_speed=%.3f\n",
+                       WEB_SWING_LOG_SIDE,
+                       motion->tickCounter,
+                       motion->vel[1]);
