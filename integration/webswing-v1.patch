+static const char *game_webSwingAutoplayStateName(WebSwingAutoplayState state)
+{
+    switch (state)
+    {
+        case WEBSWING_AUTOPLAY_WAIT_READY:       return "WAIT_READY";
+        case WEBSWING_AUTOPLAY_WAIT_ARMED:       return "WAIT_ARMED";
+        case WEBSWING_AUTOPLAY_PREROLL:          return "PREROLL";
+        case WEBSWING_AUTOPLAY_FIRST_PRESS_DOWN: return "FIRST_PRESS_DOWN";
+        case WEBSWING_AUTOPLAY_WAIT_SECOND_PRESS:return "WAIT_SECOND_PRESS";
+        case WEBSWING_AUTOPLAY_HIGH_DROP_FALL:   return "HIGH_DROP_FALL";
+        case WEBSWING_AUTOPLAY_RUNNING:          return "RUNNING";
+        default:                                 return "UNKNOWN";
+    }
+}
+
+static void game_transitionWebSwingAutoplay(WebSwingAutoplayState next,
+                                             const char *reason)
+{
+    filelog_printf("webswing.log",
+                   "WEB_SWING CLIENT autoplay previous=%s state=%s reason=%s preroll_frames=%d\n",
+                   game_webSwingAutoplayStateName(s_webSwingAutoplayState),
+                   game_webSwingAutoplayStateName(next),
+                   reason ? reason : "unspecified",
+                   s_webSwingAutoplayPrerollFrames);
+    s_webSwingAutoplayState = next;
+}
