+                player->motion->falling &&
+                s_webSwingAutoplayHighDropFrames >= WEBSWING_AUTOPLAY_HIGH_DROP_MIN_FRAMES &&
+                player->motion->vel[1] <= -1.50f)
+            {
+                filelog_printf("webswing.log",
+                               "WEB_SWING CLIENT autoplay_high_drop cast frames=%d player_y=%.3f vertical_speed=%.3f highest_y=%.3f measured_fall=%.3f\n",
+                               s_webSwingAutoplayHighDropFrames,
+                               ENTPOSY(player),
+                               player->motion->vel[1],
+                               player->motion->highest_height,
+                               MAX(0.0f, player->motion->highest_height - ENTPOSY(player)));
+                updateControlState(CONTROLID_UP, MOVE_INPUT_OTHER, 1,
+                                   control_state.time.last_send_ms);
+                s_webSwingAutoplayOwnsUp = 1;
+                game_transitionWebSwingAutoplay(WEBSWING_AUTOPLAY_RUNNING,
+                                                "high_drop_second_press");
+            }
+            break;
+
+        case WEBSWING_AUTOPLAY_RUNNING:
+            // Keep the second Space press held. Releasing it is the real Web
+            // Swing detach command; automatic assisted cycles need it on.
+            break;
+    }
+}
+
+static void game_processWebSwingAutoplayFrames(void)
+{
+    int capture_active;
+
+    if (!s_webSwingAutoplayFramesRequested ||
+        !s_webSwingAutoplayRequested ||
+        !global_state.webswing_dev)
+        return;
+
+    capture_active =
+        (s_webSwingAutoplayState == WEBSWING_AUTOPLAY_PREROLL &&
+         s_webSwingAutoplayPrerollFrames >= WEBSWING_AUTOPLAY_CAPTURE_PREROLL_START) ||
+        s_webSwingAutoplayState == WEBSWING_AUTOPLAY_FIRST_PRESS_DOWN ||
+        s_webSwingAutoplayState == WEBSWING_AUTOPLAY_WAIT_SECOND_PRESS ||
+        s_webSwingAutoplayState == WEBSWING_AUTOPLAY_HIGH_DROP_FALL ||
+        s_webSwingAutoplayState == WEBSWING_AUTOPLAY_RUNNING;
+    if (!capture_active)
+        return;
+
+    if (s_webSwingAutoplayFrameDumpCount >= s_webSwingAutoplayFrameLimit)
+    {
+        if (!s_webSwingAutoplayFrameLimitLogged)
+        {
+            filelog_printf("webswing.log",
+                           "WEB_SWING CLIENT autoplay_frames state=CAPTURE_LIMIT "
+                           "reason=bounded_capture_complete frames=%d cadence=%d stopping_autoplay=1\n",
+                           s_webSwingAutoplayFrameDumpCount,
+                           WEBSWING_AUTOPLAY_CAPTURE_CADENCE);
+            s_webSwingAutoplayFrameLimitLogged = 1;
+        }
+
+        // A bounded visual audit is one transaction: once the final requested
+        // screenshot exists, release the synthetic Space/autorun inputs and
+        // restore the previous capture flag as well.  Leaving autoplay running
+        // after the image evidence stopped used to create minutes of unrelated
+        // telemetry (and even terrain collisions) that looked like late-cycle
+        // Web Swing failures despite occurring outside the bounded review.
+        s_webSwingAutoplayRequested = 0;
+        s_webSwingAutoplayFramesRequested = 0;
+        game_resetWebSwingAutoplay(1, "bounded_capture_complete");
+        return;
+    }
+
+    if (s_webSwingAutoplayFrameCadence++ % WEBSWING_AUTOPLAY_CAPTURE_CADENCE)
+        return;
+
+    if (s_webSwingAutoplayFrameDumpCount == 0)
+    {
+        filelog_printf("webswing.log",
+                       "WEB_SWING CLIENT autoplay_frames state=CAPTURE_STARTED "
+                       "reason=late_preroll output=webswing-autoplay-capture "
+                       "limit=%d cadence=%d\n",
+                       s_webSwingAutoplayFrameLimit,
+                       WEBSWING_AUTOPLAY_CAPTURE_CADENCE);
+    }
+    gfxScreenDump("webswing-autoplay-capture", 1, "jpg");
+    s_webSwingAutoplayFrameDumpCount++;
+}
