+static const char *entClientWebSwingNativeAnchorFxName(WebSwingVisualStyle style)
+{
+    switch (style)
+    {
+        case WEB_SWING_VISUAL_STYLE_TECH:
+            return "COHSOURCEDEV/WebSwingTechAnchor.fx";
+        case WEB_SWING_VISUAL_STYLE_MAGIC:
+            return NULL;
+        default:
+            return NULL;
