+        updateControlState(CONTROLID_UP, MOVE_INPUT_OTHER, 0,
+                           control_state.time.last_send_ms);
+    }
+    if (restore_controls && s_webSwingAutoplayOwnsAutorun)
+    {
+        control_state.autorun = s_webSwingAutoplayPreviousAutorun;
+        updateControlState(CONTROLID_FORWARD, MOVE_INPUT_OTHER,
+                           control_state.autorun ? 1 : 0,
+                           control_state.time.last_send_ms);
+    }
+    if (s_webSwingAutoplayOwnsCapture)
+        g_cohsourcedev_webswing_capture = s_webSwingAutoplayPreviousCapture;
