+            }
+
+            printf("WEB_SWING SERVER test_no_attach=%d\n", enabled_bit);
+            filelog_printf("webswing.log", "WEB_SWING SERVER test_no_attach=%d\n", enabled_bit);
+        }
+    }
+}
 
