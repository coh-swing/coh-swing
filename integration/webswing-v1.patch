+static void entClientWebSwingDumpNativeAnchorFxInfo(WebSwingVisualStyle style,
+                                                    const char *fxname)
+{
+    FxInfo *info;
+    int condition_index;
+
+    if (!global_state.webswing_dev || !fxname ||
+        s_webSwingNativeAnchorDumpedStyle == style)
+        return;
+
+    info = fxGetFxInfo(fxname);
+    if (!info)
+    {
+        filelog_printf("webswing.log",
+                       "WEB_SWING CLIENT native_anchor_graph style=%d fx=%s info=NULL\n",
+                       (int)style, fxname);
+        s_webSwingNativeAnchorDumpedStyle = style;
+        return;
+    }
+
+    filelog_printf("webswing.log",
+                   "WEB_SWING CLIENT native_anchor_graph_begin style=%d fx=%s lifespan=%d inputs=%d conditions=%d animScale=%.3f clampMin=(%.3f,%.3f,%.3f) clampMax=(%.3f,%.3f,%.3f)\n",
+                   (int)style, fxname, info->lifespan, info->inputsRealCount,
+                   eaSize(&info->conditions), info->animScale,
+                   info->clampMinScale[0], info->clampMinScale[1], info->clampMinScale[2],
+                   info->clampMaxScale[0], info->clampMaxScale[1], info->clampMaxScale[2]);
+    for (condition_index = 0; condition_index < eaSize(&info->conditions); ++condition_index)
+    {
+        FxCondition *condition = info->conditions[condition_index];
+        int event_index;
+        if (!condition)
+            continue;
+        filelog_printf("webswing.log",
+                       "WEB_SWING CLIENT native_anchor_graph_condition style=%d ci=%d on=%s time=%.3f repeat=%d events=%d\n",
+                       (int)style, condition_index,
+                       condition->on ? condition->on : "<null>", condition->time,
+                       (int)condition->repeat, eaSize(&condition->events));
+        for (event_index = 0; event_index < eaSize(&condition->events); ++event_index)
+        {
+            FxEvent *event = condition->events[event_index];
+            int part_index;
+            int geom_index;
+            if (!event)
+                continue;
+            filelog_printf("webswing.log",
+                           "WEB_SWING CLIENT native_anchor_graph_event style=%d ci=%d ei=%d name=%s type=%d at=%s bhvr=%s childfx=%s anim=%s lifespan=%.3f parts=%d geoms=%d\n",
+                           (int)style, condition_index, event_index,
+                           event->name ? event->name : "<null>", (int)event->type,
+                           event->at ? event->at : "<null>",
+                           event->bhvr ? event->bhvr : "<null>",
+                           event->childfx ? event->childfx : "<null>",
+                           event->anim ? event->anim : "<null>", event->lifespan,
+                           eaSize(&event->part), eaSize(&event->geom));
+            for (part_index = 0; part_index < eaSize(&event->part); ++part_index)
+            {
+                TokenizerParams *part = event->part[part_index];
+                filelog_printf("webswing.log",
+                               "WEB_SWING CLIENT native_anchor_graph_part style=%d ci=%d ei=%d pi=%d value=%s\n",
+                               (int)style, condition_index, event_index, part_index,
+                               (part && part->params[0]) ? part->params[0] : "<null>");
+            }
+            for (geom_index = 0; geom_index < eaSize(&event->geom); ++geom_index)
+            {
+                TokenizerParams *geom = event->geom[geom_index];
+                filelog_printf("webswing.log",
+                               "WEB_SWING CLIENT native_anchor_graph_geom style=%d ci=%d ei=%d gi=%d value=%s\n",
+                               (int)style, condition_index, event_index, geom_index,
+                               (geom && geom->params[0]) ? geom->params[0] : "<null>");
+            }
+        }
+    }
+    filelog_printf("webswing.log",
+                   "WEB_SWING CLIENT native_anchor_graph_end style=%d fx=%s\n",
+                   (int)style, fxname);
+    s_webSwingNativeAnchorDumpedStyle = style;
+}
