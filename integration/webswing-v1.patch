+static int entClientWebSwingManageNativeAnchorFx(WebSwingVisualStyle style,
+                                                 const Vec3 anchor,
+                                                 const Vec3 tether_start,
+                                                 F32 anchor_fraction)
+{
+    const char *fxname = entClientWebSwingNativeAnchorFxName(style);
+    Mat4 mat;
+    Vec3 visual_anchor;
+
+    // Delay the native object until the shot is close enough to connection
+    // that it reads as the endpoint materializing, not a pre-existing object.
+    if (style == WEB_SWING_VISUAL_STYLE_MAGIC)
+    {
+        if (s_webSwingNativeAnchorFx)
+            s_webSwingNativeAnchorFx = fxDelete(s_webSwingNativeAnchorFx, SOFT_KILL);
+        return entClientWebSwingManageMagicNativeParts(anchor, tether_start,
+                                                       anchor_fraction);
+    }
+
+    if (style == WEB_SWING_VISUAL_STYLE_TECH)
+    {
+        if (s_webSwingNativeAnchorFx)
+            s_webSwingNativeAnchorFx = fxDelete(s_webSwingNativeAnchorFx, SOFT_KILL);
+        entClientWebSwingStopMagicNativeParts();
+        return entClientWebSwingManageTechAnchorModel(anchor, anchor_fraction);
+    }
+
+    entClientWebSwingStopMagicNativeParts();
+
+    if (!fxname || anchor_fraction < 0.35f || !validateVec3(anchor))
+        return 0;
+
+    entClientWebSwingDumpNativeAnchorFxInfo(style, fxname);
+
+    entClientWebSwingResolveNativeAnchorVisualPosition(anchor, tether_start,
+                                                       visual_anchor);
+    copyMat4(unitmat, mat);
+    if (style == WEB_SWING_VISUAL_STYLE_TECH)
+    {
+        // FX_Drone is compact at its stock power scale.  Treat this as a
+        // deployed anchor drone, not a tiny pet accessory.
+        scaleMat3(mat, mat, 3.0f);
+    }
+    copyVec3(visual_anchor, mat[3]);
+    s_webSwingNativeAnchorFx = fxManageWorldFx(
+        s_webSwingNativeAnchorFx, (char *)fxname, mat,
+        350.0f, 350.0f, NULL, NULL);
+    if (s_webSwingNativeAnchorLoggedStyle != style)
+    {
+        Vec3 bounds_ul = {0};
+        Vec3 bounds_lr = {0};
+        if (s_webSwingNativeAnchorFx)
+            fxFetchSides(s_webSwingNativeAnchorFx, bounds_ul, bounds_lr);
+        filelog_printf("webswing.log",
+                       "WEB_SWING CLIENT native_anchor style=%d fx=%s handle=%u anchor=(%.3f,%.3f,%.3f) visual_anchor=(%.3f,%.3f,%.3f) preview_from_player=%.3f fraction=%.3f bounds_ul=(%.3f,%.3f,%.3f) bounds_lr=(%.3f,%.3f,%.3f)\n",
+                       (int)style, fxname, (unsigned int)s_webSwingNativeAnchorFx,
+                       anchor[0], anchor[1], anchor[2],
+                       visual_anchor[0], visual_anchor[1], visual_anchor[2],
+                       g_cohsourcedev_webswing_anchor_preview_offset,
+                       anchor_fraction,
+                       bounds_ul[0], bounds_ul[1], bounds_ul[2],
+                       bounds_lr[0], bounds_lr[1], bounds_lr[2]);
+        s_webSwingNativeAnchorLoggedStyle = style;
+    }
+    return s_webSwingNativeAnchorFx != 0;
+}
+
+static void entClientWebSwingStopNativeAnchorFx(void)
+{
+    if (s_webSwingNativeAnchorFx)
+    {
+        s_webSwingNativeAnchorFx = fxDelete(s_webSwingNativeAnchorFx, SOFT_KILL);
+    }
+    s_webSwingNativeAnchorLoggedStyle = WEB_SWING_VISUAL_STYLE_LEGACY;
+    s_webSwingNativeAnchorDumpedStyle = WEB_SWING_VISUAL_STYLE_LEGACY;
+    entClientWebSwingStopMagicNativeParts();
+    if (s_webSwingTechAnchorNode)
+    {
+        gfxTreeDelete(s_webSwingTechAnchorNode);
+        s_webSwingTechAnchorNode = NULL;
+    }
+}
