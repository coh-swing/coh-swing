+static void pmotionWebSwingCaptureWriteEvent(const WebSwingCaptureFrame *frame,
+                                             const char *event_type, const char *detail)
+{
+    if (!s_web_swing_capture.events || s_web_swing_capture.events_failed)
+        return;
